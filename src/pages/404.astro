---
import MainLayout from '~/layouts/MainLayout.astro';
import { useTranslations } from '~/lib/i18n';

const locale = Astro.currentLocale ?? 'pt-BR';
const t = useTranslations(locale);
---

<MainLayout title={t('notFound.title')} description={t('notFound.description')}>
  <section class="mx-auto max-w-xl py-24">
    <div class="border-y-2 border-on-background py-16 text-center">
      <p class="eyebrow">
        <span class="text-brand-500">●</span> {t('notFound.eyebrow')}
      </p>
      <h1 class="mt-3 font-display text-6xl font-black tracking-tight text-on-background sm:text-7xl">
        404
      </h1>
      <p class="mx-auto mt-5 max-w-sm leading-relaxed text-muted">{t('notFound.description')}</p>
      <p class="mt-6 font-mono text-xs text-muted/60">{Astro.url.pathname}</p>
      <a
        href="/"
        class="mt-10 inline-block bg-brand-500 px-6 py-3 font-semibold text-white transition hover:bg-brand-400"
      >
        ← {t('nav.home')}
      </a>
    </div>
  </section>
</MainLayout>