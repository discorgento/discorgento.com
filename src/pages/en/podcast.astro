---
import MainLayout from '~/layouts/MainLayout.astro';
import Episodes from '~/components/Episodes.astro';
import { getLatestVideos } from '~/lib/youtube';
import { useTranslations } from '~/lib/i18n';

const locale = Astro.currentLocale ?? 'pt-BR';
const t = useTranslations(locale);
const videos = await getLatestVideos();
---

<MainLayout title={t('podcast.title')} description={t('podcast.desc')}>
  <section class="border-b border-border py-16 sm:py-20">
    <p class="eyebrow mb-4">
      <span class="text-brand-500">●</span> {t('podcast.eyebrow')}
    </p>
    <h1 class="text-4xl font-black tracking-tight text-on-background sm:text-5xl">{t('podcast.title')}</h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">{t('podcast.desc')}</p>
  </section>

  <section class="py-14">
    <p class="eyebrow mb-6">
      <span class="text-brand-500">●</span> {t('podcast.latest')}
    </p>
    <div class="mb-10 flex flex-col items-start justify-between gap-4 border border-border bg-surface-raised p-6 sm:flex-row sm:items-center">
      <div>
        <p class="font-display text-lg font-bold tracking-tight text-on-background">{t('podcast.seeAllTitle')}</p>
        <p class="mt-1 font-mono text-xs text-muted">{t('podcast.seeAllDesc')}</p>
      </div>
      <a
        href="https://www.youtube.com/channel/UChJitnyFtNOoCe6cu-rHcow"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        {t('podcast.channel')} →
      </a>
    </div>
    <div class="border-b border-border">
      <Episodes locale={locale} videos={videos} />
    </div>
  </section>

  <section class="pb-20">
    <p class="eyebrow mb-6">
      <span class="text-brand-500">●</span> {t('podcast.spotify')}
    </p>
    <div class="mb-10 flex flex-col items-start justify-between gap-4 border border-border bg-surface-raised p-6 sm:flex-row sm:items-center">
      <div>
        <p class="font-display text-lg font-bold tracking-tight text-on-background">{t('podcast.spotifyTitle')}</p>
        <p class="mt-1 font-mono text-xs text-muted">{t('podcast.spotifyDesc')}</p>
      </div>
      <a
        href="https://open.spotify.com/playlist/4pU2Abae7J8vdY4yqPCXRc"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        {t('podcast.spotifyChannel')} →
      </a>
    </div>
    <iframe
      src="https://open.spotify.com/embed/playlist/4pU2Abae7J8vdY4yqPCXRc?utm_source=generator&theme=0"
      class="min-h-[380px] w-full border border-border bg-surface-raised"
      frameBorder="0"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
      title="discorgento on Spotify"
    ></iframe>
  </section>
</MainLayout>