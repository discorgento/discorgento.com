---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLatestVideos, episodeNum, formatEpDate, thumb, webpSrcset, avifSrcset } from '~/lib/youtube';
import type { Video } from '~/lib/youtube';
import { useTranslations } from '~/lib/i18n';
import YouTubeStamp from '~/components/YouTubeStamp.astro';

interface Props {
  locale: string;
  video?: Video;
}

/* The home cover + write-up, rendered two ways by the same component:
 *
 *  - The `server:defer` island render: `Astro.props.video` is absent, so this
 *    fetches the channel live at request time — a new episode appears without a
 *    redeploy. That render runs on the Worker and is identical in shape to the
 *    build-time one, so the swap is invisible.
 *  - The `slot="fallback"` render (with `video`): the build-time stand-in, fed
 *    the committed snapshot by Home so the build never talks to YouTube.
 *
 * Styles live here (scoped), not in Home: an island renders outside the page's
 * component scope, so Home's `.front`/`.cover-art` rules would not reach it.
 * Because the fallback is this same component, the rules style both renders.
 */
const { locale, video } = Astro.props;
const t = useTranslations(locale);

const episode = video ?? (await getLatestVideos())[0] ?? null;

if (video === undefined) {
  /* Deliberate no-store, matching LatestEdition: the island is per-view data,
     not a cacheable asset. The YouTube feed request itself is edge-cached
     (cf.cacheTtl in youtube.ts), so this does not hammer the publication. */
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const epNum = episode ? (episodeNum(episode.title) ?? '') : '';
const epTag = epNum ? `#${epNum}` : 'podcast';
const epDate = episode ? formatEpDate(episode.published, locale) : '';
const stampText = `${epTag} · ${t('home.toc.watch')} · youtube · `;
const allEpisodesUrl = getRelativeLocaleUrl(locale, '/podcast');
const coverSizes: (320 | 640 | 1024 | 1280)[] = [320, 640, 1024, 1280];
---

{episode && (
  /* Scoped styles are compiled against this component's own attribute, so the
     island needs its own `.zine` ancestor to match the `.zine .x` rules below
     (Home's `.zine` carries Home's hash, not ours). The wrapper is a plain
     block: the layout still comes from `.wrap`. */
  <div class="zine">
    <div class="wrap front">
    <figure class="cover">
      <div class="cover-art" data-live={video === undefined ? 'true' : undefined}>
        {/* Real <img>, not a background-image: the preload scanner only finds
            the LCP candidate in markup, so a CSS-only still cannot carry
            fetchpriority and starts at Low priority. Self-hosted, so the LCP
            never waits on a third-party handshake. */}
        <picture>
          {avifSrcset(episode.id, coverSizes) && (
            <source
              type="image/avif"
              srcset={avifSrcset(episode.id, coverSizes) ?? undefined}
              sizes="(min-width: 1232px) 506px, (min-width: 900px) 42vw, 84vw"
            />
          )}
          {webpSrcset(episode.id, coverSizes) && (
            <source
              type="image/webp"
              srcset={webpSrcset(episode.id, coverSizes) ?? undefined}
              sizes="(min-width: 1232px) 506px, (min-width: 900px) 42vw, 84vw"
            />
          )}
          <img
            class="still"
            src={thumb(episode.id, 320)}
            srcset={`${thumb(episode.id, 320)} 320w, ${thumb(episode.id, 640)} 640w, ${thumb(episode.id, 1024)} 1024w, ${thumb(episode.id, 1280)} 1280w`}
            sizes="(min-width: 1232px) 506px, (min-width: 900px) 42vw, 84vw"
            alt={`discorgento — episódio ${epTag}: ${episode.title}`}
            width="1280"
            height="720"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <span class="n">{epTag}</span>
        <span class="stamp" aria-hidden="true">
          <YouTubeStamp variant="seal" uid="cover" label={stampText}>
            <text slot="text" font-size="9.5"><textPath href="#yt-stamp-path-cover">{stampText}</textPath></text>
          </YouTubeStamp>
        </span>
      </div>
      <figcaption class="figcap">
        fig. 01 — {t('home.featuredEp.title')} ·{' '}
        <a href={episode.url} target="_blank" rel="noopener noreferrer">
          {t('home.featuredEp.watch')}
        </a>
      </figcaption>
    </figure>

    <article class="lead">
      <p class="kicker">
        <span class="o">●</span> {t('home.featuredEp.eyebrow')} — {t('home.capa.tag')}
      </p>
      <h2>{episode.title}</h2>
      <p class="deck">{t('home.capa.deck')}</p>
      <div class="facts">
        <span>{t('home.capa.published')} <b>{epDate}</b></span>
        <span>{t('home.capa.medium')} <b>youtube</b></span>
        <span>{t('home.capa.by')} <b>@discorgento</b></span>
      </div>
      <div class="ctas">
        <a
          href={episode.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
          data-ep-open
          data-ep-id={episode.id}
          data-ep-title={episode.title}
        >
          ▶ {t('home.featuredEp.play')}
        </a>
        <a href={allEpisodesUrl} class="link-arrow">
          {t('home.featuredEp.all')} →
        </a>
      </div>
    </article>
    </div>
  </div>
)}

<style>
  /* These rules were scoped in Home.astro; they live here now so the island
     output (rendered at request time, outside Home's scope) is styled. The
     build-time fallback is this same component, so one copy styles both. */

  .zine .wrap {
    max-width: 74rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 640px) {
    .zine .wrap {
      padding-inline: 1.5rem;
    }
  }
  .zine a {
    color: inherit;
    text-decoration: none;
  }
  .zine .o {
    color: var(--color-brand-500);
  }
  .zine .btn {
    display: inline-block;
    position: relative;
    background: var(--color-brand-700);
    color: #fff;
    font-weight: 600;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--color-brand-700);
    transition: background 0.15s, border-color 0.15s;
  }
  @media (min-width: 640px) {
    .zine .btn {
      padding: 0.75rem 1.5rem;
    }
  }
  .zine .btn:hover {
    background: var(--color-brand-800);
    border-color: var(--color-brand-800);
  }
  .zine .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: var(--color-background);
    opacity: 0;
    clip-path: inset(26% 0 48% 0);
    will-change: transform, clip-path, opacity;
  }
  .zine .btn:hover::after {
    animation: 0.42s steps(3, end) dg-btn-tear both;
  }
  @keyframes dg-btn-tear {
    0% {
      opacity: 0;
      transform: none;
      clip-path: inset(26% 0 48% 0);
    }
    33% {
      opacity: 0.8;
      transform: translateX(-0.3rem);
      clip-path: inset(40% 0 30% 0);
    }
    66% {
      opacity: 0.55;
      transform: translateX(0.22rem);
      clip-path: inset(14% 0 60% 0);
    }
    100% {
      opacity: 0;
      transform: none;
      clip-path: inset(26% 0 48% 0);
    }
  }
  .zine .btn:not(.ghost) {
    box-shadow: 4px 4px 0 var(--color-brand-700);
    transition: background 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .zine .btn:not(.ghost):hover {
    box-shadow: 6px 6px 0 var(--color-brand-700), var(--shadow-glow-card);
  }

  .zine .front {
    display: grid;
    gap: 2.5rem;
    padding-block: 1.75rem 2.5rem;
    position: relative;
    background-color: var(--color-surface);
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(243 239 233 / 0.035) 0 1px,
      transparent 1px 10px
    );
  }
  @media (min-width: 900px) {
    .zine .front {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
      gap: 2.75rem;
    }
  }
  .zine .front::before {
    content: '';
    position: absolute;
    inset: 0 -6% auto;
    height: 26rem;
    background: radial-gradient(
      58% 62% at 50% 22%,
      rgb(236 103 55 / 0.16),
      transparent 72%
    );
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .zine .front {
      gap: 3rem;
    }
  }
  .zine .cover-art {
    position: relative;
    aspect-ratio: 16/7.5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    background-color: var(--color-background);
    animation: 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both dg-wipe;
  }
  /* The live swap is a data update, not a page load: do not re-clip the LCP
     frame while the island replaces the fallback cover. */
  .zine .cover-art[data-live] {
    animation: none;
  }
  @media (min-width: 640px) {
    .zine .cover-art {
      padding: 1.5rem 2rem;
    }
  }
  @keyframes dg-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  /* ---- parallax: CSS scroll-driven, progressive enhancement ----
     The cover lags behind the page while crossing the viewport; the pull quote
     (still in Home) drifts the other way with its own keyframes. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .zine .cover {
        animation: dg-drift linear both;
        animation-timeline: view();
      }
      @keyframes dg-drift {
        from {
          transform: translateY(-1.25rem);
        }
        to {
          transform: translateY(1.25rem);
        }
      }
    }
  }
  @media (min-width: 1024px) {
    .zine .cover-art {
      aspect-ratio: 16/9;
    }
  }
  .zine .cover-art picture {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
  }
  /* The WebP <picture> wrapper only carries a <source>; display:contents drops
     it from layout so the <img> lays out exactly as before. */
  .zine .cover-art picture {
    display: contents;
  }
  .zine .cover-art .still {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .zine .cover-art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: linear-gradient(
      to bottom,
      rgba(13, 10, 5, 0.72),
      rgba(13, 10, 5, 0.18) 45%,
      rgba(13, 10, 5, 0.55)
    );
    pointer-events: none;
  }
  .zine .cover:hover .cover-art .still {
    transform: scale(1.04);
  }
  .zine .cover-art > *:not(picture) {
    position: relative;
    z-index: 2;
  }
  .zine .cover-art .stamp {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    line-height: 0;
  }
  .zine .cover-art .n {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(1.9rem, 8vw, 8.5rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 2px rgba(13, 10, 5, 0.55), 0 2px 14px rgba(13, 10, 5, 0.55);
  }
  .zine .cover .figcap {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .zine .cover .figcap a {
    color: var(--color-on-background);
    text-decoration: underline;
    text-decoration-color: var(--color-brand-500);
    text-underline-offset: 0.25rem;
    transition: color 0.15s;
  }
  .zine .cover .figcap a:hover {
    color: var(--color-brand-500);
  }
  .zine .lead {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }
  .zine .lead .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-muted);
    margin-bottom: 0.35rem;
  }
  .zine .lead h2 {
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(1.25rem, 4vw, 3rem);
    text-wrap: balance;
  }
  .zine .lead .deck {
    margin-top: 1rem;
    max-width: 38rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .zine .lead .deck::first-letter {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3.2em;
    line-height: 0.8;
    float: left;
    padding: 0.06em 0.1em 0 0;
    color: var(--color-brand-400);
  }
  .zine .lead .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dotted var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .zine .lead .facts b {
    color: var(--color-on-background);
    font-weight: 500;
  }
  .zine .lead .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    align-items: center;
  }
  .zine .link-arrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-brand-400);
  }
  .zine .link-arrow:hover {
    text-decoration: underline;
  }

  /* Hero compaction in the shared mobile block from Home, cover half. */
  @media (max-width: 767px) {
    .zine .cover-art {
      padding: 0.6rem 0.8rem;
    }
    .zine .front {
      padding-block: 0.35rem 1.5rem;
    }
    .zine .cover .figcap {
      font-size: 0.7rem;
      line-height: 1.35;
      margin-top: 0.4rem;
    }
    .zine .lead .deck {
      line-height: 1.42;
    }
    .zine .lead .facts {
      margin-top: 0.8rem;
      padding-top: 0.65rem;
      gap: 0.25rem 0.85rem;
    }
    .zine .lead .ctas {
      margin-top: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zine .cover-art .still,
    .zine .cover-art .stamp {
      transition: none;
    }
    .zine .cover:hover .cover-art .still {
      transform: none;
    }
    .zine .cover-art,
    .zine .btn:not(.ghost) {
      animation: none;
      transition: none;
      transform: none;
    }
  }

  /* Mobile tap targets: the cover links grow an invisible overlay, as in Home. */
  @media (max-width: 639px) {
    .zine .link-arrow,
    .zine .cover .figcap a {
      position: relative;
    }
    .zine .link-arrow::after,
    .zine .cover .figcap a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 44px;
      transform: translateY(-50%);
    }
  }
</style>