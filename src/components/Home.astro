---
import Byline from '~/components/home/Byline.astro';
import Colophon from '~/components/home/Colophon.astro';
import Contents from '~/components/home/Contents.astro';
import EpisodePlayer from '~/components/home/EpisodePlayer.astro';
import EpisodesBand from '~/components/home/EpisodesBand.astro';
import Join from '~/components/home/Join.astro';
import Masthead from '~/components/home/Masthead.astro';
import Newsletter from '~/components/home/Newsletter.astro';
import PullQuote from '~/components/home/PullQuote.astro';
import Team from '~/components/home/Team.astro';
import LatestEpisode from '~/components/LatestEpisode.astro';
import { getDiscordStats } from '~/lib/discord';
import { getTeam } from '~/lib/team';
import { episodeNum, formatEpDate, getSnapshotVideos } from '~/lib/youtube';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

// Validated against the Video shape: a malformed hand-maintained snapshot must
// fail the build, never ship silently. getLatestVideos() uses the same gate.
const videos = getSnapshotVideos();
const discord = await getDiscordStats();

// The cover and the episodes grid are server islands that fetch YouTube live at
// request time — a new episode shows up without a redeploy. The build ships the
// committed snapshot as their static fallback instead of hitting the (flaky)
// feed during the build, and the residuals below (terminal, toc, pull quote)
// read the same snapshot by design: the site must never fail over a news feed.
const firstVideo = videos[0] ?? null;
const epNum = firstVideo ? (episodeNum(firstVideo.title) ?? '') : '';
const epTag = epNum ? `#${epNum}` : 'podcast';
const epDate = firstVideo ? formatEpDate(firstVideo.published, locale) : '';

const hosts = getTeam(locale);
---

{/* The page is a stack of sections in src/components/home/. Each one carries its
    own styles; this file keeps only what spans the whole page — the .zine root,
    buttons, section heads and the scroll reveal. Section styles hang off this
    .zine root, so they are written `:global(.zine) …` in the section files, and
    the shared rules here reach into them with `.zine :global(…)`. */}
<Masthead locale={locale} />

<main
  id="main"
  tabindex="-1"
  class="mx-auto w-full max-w-[74rem] flex-1 px-5 focus:outline-none sm:px-6"
>
  <div class="zine -mx-5 sm:-mx-6">
    <!-- CAPA -->
    {firstVideo && (
      <LatestEpisode server:defer locale={locale}>
        <LatestEpisode slot="fallback" locale={locale} video={firstVideo} />
      </LatestEpisode>
    )}
    <Byline locale={locale} hosts={hosts} />
    <Colophon
      locale={locale}
      firstVideo={firstVideo}
      epTag={epTag}
      epDate={epDate}
      discord={discord}
    />
    <Contents locale={locale} epTag={epTag} />
    {videos.length > 0 && <EpisodesBand locale={locale} videos={videos} />}
    <Newsletter locale={locale} />
    <PullQuote locale={locale} firstVideo={firstVideo} epTag={epTag} />
    <Team locale={locale} hosts={hosts} />
    <Join locale={locale} />
  </div>

  <EpisodePlayer locale={locale} />
</main>

<style>
  /* ============================================================
     HOME — editorial fanzine (dark)
     Reuses the global palette tokens from src/styles/global.css.
     Page-wide rules only; each section's own styles live with it.
     ============================================================ */
  .zine {
    --term: #0d0a05;
    --term-line: #2e2618;
    counter-reset: dg-sec;
  }
  .zine :global(.wrap) {
    max-width: 74rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 640px) {
    .zine :global(.wrap) {
      padding-inline: 1.5rem;
    }
  }
  /* No link reset here: Tailwind's preflight already gives every <a>
     color: inherit and text-decoration: inherit. */
  .zine :global(.mono) {
    font-family: var(--font-mono);
  }
  .zine :global(.small) {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .zine :global(.o) {
    color: var(--color-brand-500);
  }
  .zine :global(.face) {
    display: block;
    object-fit: cover;
    background: var(--color-surface-raised);
  }

  /* ---- buttons ---- */
  .zine :global(.btn) {
    display: inline-block;
    /* position: relative anchors the tear band; no child of .btn is absolutely
       positioned, so nothing that existed depended on the button being static. */
    position: relative;
    background: var(--color-brand-700);
    color: #fff;
    font-weight: 600;
    /* Tightened on mobile: 1.5rem of inline padding plus a long label is what
       pushes a call-to-action past the viewport edge on a narrow phone. */
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--color-brand-700);
    transition: background 0.15s, border-color 0.15s;
  }
  @media (min-width: 640px) {
    .zine :global(.btn) {
      padding: 0.75rem 1.5rem;
    }
  }
  .zine :global(.btn:hover) {
    background: var(--color-brand-800);
    border-color: var(--color-brand-800);
  }
  /* Tear band, same clip-path read as the logo. Kept off the text: the band sits
     behind the label via z-index 0 against the button's own stacking, and the
     ::after carries no content of its own, so nothing reflows. */
  .zine :global(.btn::after) {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: var(--color-background);
    opacity: 0;
    clip-path: inset(26% 0 48% 0);
    will-change: transform, clip-path, opacity;
  }
  .zine :global(.btn:hover::after) {
    animation: 0.42s steps(3, end) dg-btn-tear both;
  }
  @keyframes dg-btn-tear {
    0% {
      opacity: 0;
      transform: none;
      clip-path: inset(26% 0 48% 0);
    }
    33% {
      opacity: 0.8;
      transform: translateX(-0.3rem);
      clip-path: inset(40% 0 30% 0);
    }
    66% {
      opacity: 0.55;
      transform: translateX(0.22rem);
      clip-path: inset(14% 0 60% 0);
    }
    100% {
      opacity: 0;
      transform: none;
      clip-path: inset(26% 0 48% 0);
    }
  }
  /* Solid buttons get the sticker treatment plus the glow token that was
     defined in global.css but never used. The hover no longer nudges the button
     1px up-left: with the tear band crossing the label at the same time, the
     movement read as two things happening at once. The shadow still grows, so
     the sticker still lifts. */
  .zine :global(.btn:not(.ghost)) {
    box-shadow: 4px 4px 0 var(--color-brand-700);
    transition: background 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .zine :global(.btn:not(.ghost):hover) {
    box-shadow: 6px 6px 0 var(--color-brand-700), var(--shadow-glow-card);
  }
  .zine :global(.btn.ghost) {
    background: transparent;
    border-color: var(--color-brand-700);
    color: var(--color-on-background);
  }
  .zine :global(.btn.ghost:hover) {
    background: var(--color-background);
    border-color: var(--color-brand-600);
  }
  /* The ink band is invisible against the dark fill a ghost button takes on
     hover, so the ghost variant tears in brand orange instead. */
  .zine :global(.btn.ghost::after) {
    background-color: var(--color-brand-500);
  }

  /* Everything past the first screenful is off-screen on load. Skipping its layout
     and paint cuts the initial style/layout pass; contain-intrinsic-size keeps the
     scrollbar honest until the section is drawn. Deliberately outside any
     @supports or reduced-motion query: neither has anything to do with it.
     Must not touch the IntersectionObserver reveal: a content-visibility subtree is
     not laid out, so its .reveal children never intersect to fire — hence
     :not(.in). (The colophon band carries the same rule in Colophon.astro.) */
  .zine :global(.block:not(.in)) {
    content-visibility: auto;
    contain-intrinsic-size: auto 800px;
  }
  .zine :global(.link-arrow) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-brand-400);
  }
  .zine :global(.link-arrow:hover) {
    text-decoration: underline;
  }

  /* ---- scroll reveal (driven by the script below) ---- */
  :global(.js) .zine :global(.reveal) {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  :global(.js) .zine :global(.reveal.in) {
    opacity: 1;
    transform: none;
  }
  /* headings rise out of a mask as the section enters */
  :global(.js) .zine :global(.reveal h2),
  :global(.js) .zine :global(.reveal .eyebrow) {
    clip-path: inset(0 0 100% 0);
    transform: translateY(0.45em);
    padding-bottom: 0.06em;
    /* colour and glow ride along so the heading hover can fade; the reveal
       still owns clip-path and transform. */
    transition: clip-path 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.08s,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.08s,
      color 0.28s ease, text-shadow 0.28s ease;
  }
  :global(.js) .zine :global(.reveal.in h2),
  :global(.js) .zine :global(.reveal.in .eyebrow) {
    clip-path: inset(0);
    transform: none;
  }

  /* ---- sections ---- */
  .zine :global(section.block) {
    border-top: 1px solid var(--color-border);
    padding-block: 2.5rem;
  }
  @media (min-width: 640px) {
    .zine :global(section.block) {
      padding-block: 4.5rem;
    }
  }
  @media (min-width: 1024px) {
    .zine :global(section.block) {
      padding-block: 5.25rem;
    }
  }
  .zine :global(.sec-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding-bottom: 0.9rem;
    position: relative;
  }
  /* The section rule is drawn, not painted: it pulls itself across the page as
     the section enters, the way a rule prints left to right. */
  .zine :global(.sec-head::after) {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-on-background);
    transform: scaleX(0);
    transform-origin: left center;
  }
  :global(.js) .zine :global(.reveal.in .sec-head::after) {
    transition: transform 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s;
    transform: scaleX(1);
  }
  .zine :global(.sec-head h2) {
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: clamp(1.3rem, 3vw, 2.1rem);
    text-wrap: balance;
  }
  /* Section heading hover: a warm brand tint and a soft glow, nothing that
     touches the font metrics. Swapping the variable-font axes here (the old
     'wght' 780 / WONK 1 jump) re-drew every glyph wider, so the line re-wrapped
     and the heading visibly swelled under the cursor. */
  .zine :global(.sec-head h2:hover) {
    color: var(--color-brand-500);
    text-shadow: 0 0 0.5rem rgb(236 103 55 / 0.45);
  }
  /* Outlined numerals: one per headed section, counter bumped on the head so
     headless sections never consume a number. */
  .zine :global(.sec-head) {
    counter-increment: dg-sec;
  }
  .zine :global(.sec-head .eyebrow::before) {
    content: counter(dg-sec, decimal-leading-zero);
    display: block;
    margin-bottom: 0.15rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.9rem, 5vw, 3.4rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-brand-500);
    opacity: 0.6;
  }
  .zine :global(.sec-head .eyebrow) {
    margin-bottom: 0.35rem;
  }

  /* ---- movimento reduzido ---- */
  @media (prefers-reduced-motion: reduce) {
    .zine :global(.btn) {
      animation: none;
    }
    :global(.js) .zine :global(.reveal) {
      opacity: 1;
      transform: none;
      transition: none;
    }
    :global(.js) .zine :global(.reveal h2),
    :global(.js) .zine :global(.reveal .eyebrow) {
      clip-path: none;
      transform: none;
      transition: none;
    }
    /* The drawn rule is motion, not decoration: land it in its final state
       instead of leaving it invisible. */
    :global(.js) .zine :global(.reveal.in .sec-head::after) {
      transform: none;
      transition: none;
    }
    /* The load-in choreography is motion, so it goes. (The cover wipe and the
       card animations live in LatestEpisode / HomeEpisodes.) */
    .zine :global(.btn:not(.ghost)) {
      animation: none;
      transition: none;
      transform: none;
    }
  }

  /* ---- Mobile tap targets ----
     Apple asks for 44px, Material for 48dp. Small links measure 18-36px on a
     phone, which is the usual reason a site feels imprecise under the thumb: you
     aim at a thin line and miss it. Padding is not the fix — it would push the
     surrounding layout down — so each target grows an invisible overlay instead.
     Type size, visual box and spacing are all untouched, which is why this is
     scoped to below 640px: on a pointer device a 19px link is perfectly normal to
     hit and a 44px one is just a fat row.

     The overlay is centred on the link rather than stretched, so a link that is
     already 36px only gains 4px per side and a 19px one gains ~12px. That
     matters because the colophon links sit 9.6px apart — an inset-based
     expansion large enough for the 19px links would overlap there. The section
     files repeat this overlay for their own small links. */
  @media (max-width: 639px) {
    .zine :global(.link-arrow) {
      position: relative;
    }
    .zine :global(.link-arrow::after) {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 44px;
      transform: translateY(-50%);
    }
  }
</style>

<script>
  document.documentElement.classList.add('js');

  // Scroll reveal: each .reveal gets .in the first time it enters the viewport.
  const items = document.querySelectorAll('.zine .reveal');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('in'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
    );
    items.forEach((el) => observer.observe(el));
  }
</script>
