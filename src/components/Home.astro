---
import { getLatestVideos, episodeNum, formatEpDate } from '~/lib/youtube';
import { getDiscordStats } from '~/lib/discord';
import { getLatestSubstackPosts } from '~/lib/substack';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '~/lib/i18n';
import { getTeam } from '~/lib/team';
import Navbar from '~/components/Navbar.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const otherLocale = locale === 'pt-BR' ? 'en' : 'pt-BR';

const [youtubeVideos, discord, substackPosts] = await Promise.all([
  getLatestVideos(),
  getDiscordStats(),
  getLatestSubstackPosts(1),
]);
const latestPost = substackPosts[0] ?? null;

const firstVideo = youtubeVideos[0] ?? null;
const epNum = firstVideo ? (episodeNum(firstVideo.title) ?? '') : '';
const epTag = epNum ? `#${epNum}` : 'podcast';
const epDate = firstVideo ? formatEpDate(firstVideo.published, locale) : '';
const stampText = `${epTag} · ${t('home.toc.watch')} · youtube · `;

const hosts = getTeam(locale);

const mastheadSub = t('home.hero.eyebrow').split(' · ');
const dateline = new Intl.DateTimeFormat(locale === 'pt-BR' ? 'pt-BR' : 'en-US', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
const youtubeUrl = 'https://www.youtube.com/@discorgento';
const spotifyUrl = 'https://open.spotify.com/playlist/4pU2Abae7J8vdY4yqPCXRc';
const substackUrl = 'https://discorgento.substack.com';
const discordUrl = 'https://discorgento.com/discord';
const githubUrl = 'https://github.com/discorgento';
const twitterUrl = 'https://twitter.com/discorgento';
---

<div class="zine -mx-5 sm:-mx-6">
  <!-- MASTHEAD -->
  <header class="wrap masthead">
    <h1 class="lockup">
      <img src="/img/logo.svg" alt="discorgento" class="logo" width="48" height="48" />
      <span class="word" aria-label="discorgento">
        {'discorgento'
          .split('')
          .map((ch, i) => (
            <span class="l" aria-hidden="true" style={`--i:${i}`}>
              {ch}
            </span>
          ))}
      </span>
    </h1>
    <div class="sub">
      {mastheadSub.map((part, i) => (
        <span class="bit">
          {i > 0 && <span class="o" aria-hidden="true">●</span>}
          <span>{part}</span>
        </span>
      ))}
    </div>
    <p class="dateline">{dateline}</p>
  </header>
  <div class="rule"></div>

  <!-- NAV: same running head as the inner pages, minus the lockup (the masthead above is it) -->
  <Navbar showLockup={false} />

  <!-- CAPA -->
  <div class="wrap front">
    {firstVideo && (
      <figure class="cover">
        <div
          class="cover-art"
          role="img"
          aria-label={`discorgento — episódio ${epTag}: ${firstVideo.title}`}
          style={`--thumb-max: url('https://i.ytimg.com/vi/${firstVideo.id}/maxresdefault.jpg'); --thumb-hq: url('https://i.ytimg.com/vi/${firstVideo.id}/hqdefault.jpg')`}
        >
          <span class="n">{epTag}</span>
          <a href={firstVideo.url} target="_blank" rel="noopener noreferrer" class="badge">
            ▶ {t('home.featuredEp.watch')}
          </a>
          <a
            href={firstVideo.url}
            target="_blank"
            rel="noopener noreferrer"
            class="stamp"
            aria-label={`${epTag} — ${t('home.featuredEp.watch')}`}
          >
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
              <circle cx="50" cy="50" r="33" fill="none" stroke="currentColor" stroke-width="1.4" />
              <defs>
                <path id="stampPath" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0" />
              </defs>
              <text><textPath href="#stampPath">{stampText}</textPath></text>
            </svg>
          </a>
        </div>
        <figcaption class="figcap">fig. 01 — {t('home.featuredEp.title')}</figcaption>
      </figure>
    )}

    {firstVideo && (
      <article class="lead">
        <p class="kicker">
          <span class="o">●</span> {t('home.featuredEp.eyebrow')} — {t('home.capa.tag')}
        </p>
        <h2>{firstVideo.title}</h2>
        <p class="deck">{t('home.capa.deck')}</p>
        <div class="facts">
          <span>{t('home.capa.published')} <b>{epDate}</b></span>
          <span>{t('home.capa.medium')} <b>youtube</b></span>
          <span>{t('home.capa.by')} <b>@discorgento</b></span>
        </div>
        <div class="ctas">
          <a href={firstVideo.url} target="_blank" rel="noopener noreferrer" class="btn">
            ▶ {t('home.featuredEp.watch')} →
          </a>
          <a href={getRelativeLocaleUrl(locale, '/podcast')} class="link-arrow">
            {t('home.featuredEp.all')} →
          </a>
        </div>
      </article>
    )}

    </div>

  <!-- BYLINE (as caras logo abaixo da capa) -->
  <div class="byline reveal">
    <div class="wrap row">
      <span class="lbl">{t('home.hosts.byline')}</span>
      <ul>
        {hosts.map((person) => (
          <li>
            <a
              class="face-link"
              href={person.profile}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${person.name} — ${t('home.hosts.profile')}`}
            >
              {person.photo ? (
                <img
                  class="face"
                  src={person.photo}
                  alt={person.name}
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="face monogram" aria-hidden="true">{person.initials}</span>
              )}
            </a>
            <span class="nm">{person.name.split(' ')[0]}</span>
          </li>
        ))}
      </ul>
      <a class="all" href="#quem-faz">{t('home.hosts.all')} →</a>
    </div>
  </div>

  <!-- COLOPHON + SIGNATURES (colophon block) -->
  <div class="colofao reveal">
    <div class="wrap">
      <div class="colophon" role="region" aria-label={t('home.terminal.aria')}>
        <div class="h">
          <span>terminal discorgento</span>
          <span class="dots" aria-hidden="true"><i></i><i></i><i class="o"></i></span>
        </div>
        <div class="b">
          <p class="cmd"><span class="p">$</span> ./discorgento --info</p>
          <div class="sep"></div>
          <p class="f">&gt; {t('home.terminal.stack')}</p>
          <p>{t('home.terminal.stackValue')}</p>
          <p class="f">&gt; {t('home.terminal.since')}</p>
          <p>{t('home.terminal.sinceValue')}</p>
          <p class="f">&gt; {t('home.terminal.format')}</p>
          <p>{t('home.terminal.formatValue')}</p>
          {firstVideo && (
            <>
              <p class="f">&gt; {t('home.terminal.lastEp')}</p>
              <p class="ep">
                <a href={firstVideo.url} target="_blank" rel="noopener noreferrer">
                  {epTag} · {firstVideo.title} ({epDate})
                </a>
              </p>
            </>
          )}
        </div>
        <div class="cap">
          <span><span class="led" aria-hidden="true"></span>online</span>
          <span>v0.0.1 · astro</span>
        </div>
      </div>

      <div class="subs">
        <p class="eyebrow"><span class="o">●</span> {t('home.subs.eyebrow')}</p>
        <ul>
          <li><a href={youtubeUrl} target="_blank" rel="noopener noreferrer">youtube.com/@discorgento <span class="go">→</span></a></li>
          <li><a href={spotifyUrl} target="_blank" rel="noopener noreferrer">open.spotify.com/discorgento <span class="go">→</span></a></li>
          <li><a href={substackUrl} target="_blank" rel="noopener noreferrer">substack · newsletter <span class="go">→</span></a></li>
          <li><a href={twitterUrl} target="_blank" rel="noopener noreferrer">twitter.com/discorgento <span class="go">→</span></a></li>
          <li><a href={discordUrl} target="_blank" rel="noopener noreferrer">discorgento.com/discord <span class="go">→</span></a></li>
        </ul>
        <div class="stats">
          {discord && (
            <>
              <span><b>{discord.members}</b> {t('home.stats.members')}</span>
              <span><b>{discord.online}</b> {t('home.stats.online')}</span>
            </>
          )}
          <span><b>{t('home.stats.since')}</b></span>
        </div>
      </div>
    </div>
  </div>

  <!-- SUMÁRIO -->
  <section class="block reveal">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow"><span class="o">●</span> {t('home.features.eyebrow')}</p>
          <h2>{t('home.toc.title')}</h2>
        </div>
        <span class="mono small">{t('home.toc.label')}</span>
      </div>
      <div class="toc-big">
        <a href={getRelativeLocaleUrl(locale, '/podcast')} class="row">
          <span class="num">01</span>
          <span class="mid">
            <h3>{t('home.feature.podcast.title')}</h3>
            <p>{t('home.feature.podcast.desc')}</p>
          </span>
          <span class="pg"><u>ep. {epTag}</u> {t('home.toc.watch')}</span>
        </a>
        <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="row">
          <span class="num">02</span>
          <span class="mid">
            <h3>{t('home.feature.community.title')}</h3>
            <p>{t('home.feature.community.desc')}</p>
          </span>
          <span class="pg"><u>discord.gg</u> {t('home.toc.enter')}</span>
        </a>
        <a href={substackUrl} target="_blank" rel="noopener noreferrer" class="row">
          <span class="num">03</span>
          <span class="mid">
            <h3>{t('home.feature.substack.title')}</h3>
            <p>{t('home.feature.substack.desc')}</p>
          </span>
          <span class="pg"><u>substack.com</u> {t('home.toc.subscribe')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- EPISÓDIOS -->
  {youtubeVideos.length > 0 && (
    <section class="block reveal">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow"><span class="o">●</span> {t('home.episodes.eyebrow')}</p>
            <h2>{t('home.episodes.title')}</h2>
          </div>
          <a href={getRelativeLocaleUrl(locale, '/podcast')} class="link-arrow">
            {t('home.featuredEp.all')} →
          </a>
        </div>
        <div class="eps">
          {youtubeVideos.slice(0, 4).map((ep) => (
            <a href={ep.url} target="_blank" rel="noopener noreferrer" class="ep">
              <div
                class="art"
                role="img"
                aria-label={ep.title}
                style={`background-image: url('https://i.ytimg.com/vi/${ep.id}/hqdefault.jpg')`}
              ></div>
              <div class="body">
                <p class="meta">
                  <span class="num">{episodeNum(ep.title) ? `#${episodeNum(ep.title)}` : t('home.featuredEp.eyebrow')}</span>
                  <span class="date">{formatEpDate(ep.published, locale)}</span>
                </p>
                <h3 class="title">{ep.title}</h3>
                <p class="go">{t('home.toc.watch')}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- NEWSLETTER -->
  <section class="block reveal inverted">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow"><span class="o">●</span> {t('home.newsletter.eyebrow')}</p>
          <h2>{t('home.newsletter.title')}</h2>
        </div>
        <a href={substackUrl} target="_blank" rel="noopener noreferrer" class="link-arrow">
          {t('home.newsletter.read')} →
        </a>
      </div>
      {latestPost ? (
        <a href={latestPost.url} target="_blank" rel="noopener noreferrer" class="edition">
          <p class="meta">
            <span class="tag">{t('home.newsletter.tag')}</span>
            <span class="date">{formatEpDate(latestPost.published, locale)}</span>
          </p>
          <h3>{latestPost.title}</h3>
          <p class="go">{t('home.newsletter.read')} →</p>
        </a>
      ) : (
        <a href={substackUrl} target="_blank" rel="noopener noreferrer" class="edition">
          <p class="meta">
            <span class="tag">{t('home.newsletter.tag')}</span>
          </p>
          <h3>{t('home.newsletter.empty')}</h3>
          <p class="go">{t('home.sign.substack')} →</p>
        </a>
      )}
    </div>
  </section>

  <!-- PULL QUOTE -->
  <div class="wrap">
    <div class="pullquote reveal">
      <span class="qm" aria-hidden="true">“</span>
      <p>{t('home.pullquote')}</p>
      <p class="src">{t('home.pullquote.src')}</p>
      {firstVideo && (
        <p class="pick">
          <a href={firstVideo.url} target="_blank" rel="noopener noreferrer">
            {epTag} · {firstVideo.title} →
          </a>
        </p>
      )}
    </div>
  </div>

  <!-- TEAM (who makes it) -->
  <section class="block reveal halftone" id="quem-faz">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow"><span class="o">●</span> {t('home.hosts.eyebrow')}</p>
          <h2>{t('home.hosts.title')}</h2>
        </div>
        <a class="link-arrow" href={getRelativeLocaleUrl(locale, '/quem-faz')}>
          {t('home.hosts.all')} →
        </a>
      </div>
      <p class="hosts-note">{t('home.hosts.desc')}</p>
      <div class="hosts-grid">
        {hosts.map((person, index) => (
          <article class="host">
            <a
              class="ph"
              href={person.profile}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${person.name} — ${t('home.hosts.profile')}`}
            >
              {person.photo ? (
                <img
                  class="face"
                  src={person.photo}
                  alt={person.name}
                  width="400"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="face monogram" aria-hidden="true">{person.initials}</span>
              )}
              <span class="idx" aria-hidden="true">0{index + 1}</span>
              <span class="see" aria-hidden="true">{t('home.hosts.profile')} ↗</span>
            </a>
            <div class="who">
              <h3>{person.name}</h3>
              <span class="rule" aria-hidden="true"></span>
              <p class="role">{person.role}</p>
              <div class="socials">
                {person.socials.map((social) => (
                  <a
                    class="s"
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${person.name} — ${social.label}`}
                  >
                    {social.label} <span class="ext" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ASSINATURA (CTA) -->
  <section class="block sign reveal">
    <div class="wrap inner" style="padding-block: 0">
      <p class="eyebrow"><span class="o">●</span> {t('home.join.eyebrow')}</p>
      <h2>{t('home.join.title')}</h2>
      <p>{t('home.join.desc')}</p>
      <div class="ctas">
        <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="btn">
          {t('home.hero.ctaDiscord')}
        </a>
        <a href={substackUrl} target="_blank" rel="noopener noreferrer" class="btn ghost">
          {t('home.sign.substack')}
        </a>
        <button type="button" class="btn ghost" data-copy={discordUrl}>{t('share.copy')}</button>
      </div>
    </div>
  </section>
</div>

<dialog
  class="ep-modal"
  data-ep-modal
  aria-label={t('player.title')}
  style="position:fixed;inset:0;width:100%;max-width:56rem;height:fit-content;max-height:100dvh;margin:auto;"
>
  <button type="button" class="ep-modal-close" data-player-close aria-label={t('player.close')}>×</button>
  <div
    class="ep-modal-frame"
    data-ep-frame
    style="position:relative;width:100%;aspect-ratio:16/9;"
  >
  </div>
</dialog>
<div class="toast" data-toast data-copied={t('share.copied')} role="status" aria-live="polite"></div>

<style>
  /* ============================================================
     HOME — editorial fanzine (dark)
     Reuses the global palette tokens from src/styles/global.css
     ============================================================ */
  .zine {
  --term: #0d0a05;
  --term-line: #2e2618;
  counter-reset: dg-sec;
}
  .zine .wrap {
    max-width: 74rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 640px) {
    .zine .wrap {
      padding-inline: 1.5rem;
    }
  }
  .zine a {
    color: inherit;
    text-decoration: none;
  }
  .zine .mono {
    font-family: var(--font-mono);
  }
  .zine .small {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .zine .o {
    color: var(--color-brand-500);
  }
  .zine .btn {
    display: inline-block;
    background: var(--color-brand-500);
    color: #fff;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-brand-500);
    transition: background 0.15s;
  }
  .zine .btn:hover {
    background: var(--color-brand-400);
  }
  /* Solid buttons get the sticker treatment plus the glow token that was
     defined in global.css but never used. */
  .zine .btn:not(.ghost) {
    box-shadow: 4px 4px 0 var(--color-brand-500);
    transition: background 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .zine .btn:not(.ghost):hover {
    transform: translate(-1px, -1px);
    box-shadow: 6px 6px 0 var(--color-brand-500), var(--shadow-glow-card);
  }
  .zine .btn.ghost {
    background: transparent;
    border-color: var(--color-brand-500);
    color: var(--color-on-background);
  }
  .zine .btn.ghost:hover {
    background: var(--color-background);
  }

  /* ---- masthead (full-height hero) ---- */
  .zine .masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 0;
    padding-block: 0.9rem 0.75rem;
  }
  .zine .masthead .lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-weight: 900;
    letter-spacing: -0.045em;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    line-height: 0.86;
    text-transform: lowercase;
  }
  .zine .masthead .lockup .logo {
    height: 2.5rem;
    width: 2.5rem;
    flex-shrink: 0;
  }
  /* Marker sweep under the wordmark + print misregistration ghost. */
  .zine .masthead:hover .lockup .word {
    /* Print misregistration: the word splits into two passes on hover. */
    text-shadow: -0.03em 0 0 var(--color-brand-500), 0.03em 0 0 var(--color-brand-400);
  }
  /* The wordmark lands misregistered and pulls into register, like a press
       that missed the first pull. No fill mode on the second animation, so the
       hover transition still works. */
  .zine .masthead .lockup .word {
    background-image: linear-gradient(var(--color-brand-500), var(--color-brand-500));
    background-repeat: no-repeat;
    background-position: 0 84%;
    background-size: 0% 0.1em;
    text-shadow: 0.02em 0 0 var(--color-brand-500);
    transition: text-shadow 0.18s ease;
    animation:
      0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards dg-marker,
      0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.55s dg-register;
  }
  @keyframes dg-register {
    0% {
      text-shadow: -0.1em 0 0 var(--color-brand-500), 0.1em 0 0 var(--color-brand-400);
    }
    60% {
      text-shadow: -0.05em 0 0 var(--color-brand-500), 0.05em 0 0 var(--color-brand-400);
    }
    100% {
      text-shadow: 0.02em 0 0 var(--color-brand-500);
    }
  }
  @keyframes dg-marker {
    to {
      background-size: 100% 0.1em;
    }
  }
  /* Letters drop into place one by one, like type being set. */
  .zine .masthead .lockup .l {
    display: inline-block;
    animation: 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both dg-letter;
    animation-delay: calc(var(--i) * 40ms + 120ms);
  }
  @keyframes dg-letter {
    from {
      opacity: 0;
      transform: translateY(-0.32em) rotate(-5deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .zine .masthead .lockup .word {
      animation: none;
      background-size: 100% 0.1em;
    }
    .zine .masthead .lockup .l {
      animation: none;
    }
  }
  .zine .masthead .sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.9rem;
    justify-content: center;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-muted);
  }
  /* One unit per word so the ● keeps equal space on both sides and never wraps alone. */
  .zine .masthead .sub .bit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
  }
  .zine .masthead .dateline {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-muted);
  }
  .zine .rule {
    height: 2px;
    background: var(--color-on-background);
  }
  .zine .rule.thin {
    height: 1px;
    background: var(--color-border);
  }

  /* ---- nav ---- */
  .zine .navprint .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.6rem;
  }
  .zine .nav-l {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .zine .nav-l a {
    color: var(--color-on-background);
    transition: color 0.15s;
  }
  .zine .nav-l a:hover {
    color: var(--color-brand-400);
  }
  .zine .nav-l .discord {
    color: var(--color-brand-500);
    font-weight: 700;
  }
  .zine .nav-r {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* ---- capa ---- */
  .zine .front {
    display: grid;
    gap: 2.5rem;
    padding-block: 1.75rem 2.5rem;
    position: relative;
  }
  /* Ambient depth: a soft brand bloom behind the cover, so the risograph
     art sits in light instead of floating on flat black. */
  .zine .front::before {
    content: '';
    position: absolute;
    inset: 0 -6% auto;
    height: 26rem;
    background: radial-gradient(
      58% 62% at 50% 22%,
      rgb(236 103 55 / 0.16),
      transparent 72%
    );
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .zine .front {
      gap: 3rem;
    }
  }
  .zine .cover-art {
    position: relative;
    aspect-ratio: 16/7.5;
    border: 1px solid rgba(255, 255, 255, 0.22);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    background-color: var(--color-background);
    /* Cover prints itself in from the left on load. */
    animation: 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both dg-wipe;
  }
  @keyframes dg-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @media (min-width: 1024px) {
/* ---- parallax: CSS scroll-driven, progressive enhancement ----
     Browsers without animation-timeline simply don't move anything. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* The cover lags behind the page while crossing the viewport. */
      .zine .cover {
        animation: dg-drift linear both;
        animation-timeline: view();
      }
      /* The quote drifts the other way, so the two layers read as depth. */
      .zine .pullquote {
        animation: dg-drift-quote linear both;
        animation-timeline: view();
      }
      @keyframes dg-drift {
        from {
          transform: translateY(-1.25rem);
        }
        to {
          transform: translateY(1.25rem);
        }
      }
      @keyframes dg-drift-quote {
        from {
          transform: translateY(0.875rem);
        }
        to {
          transform: translateY(-0.875rem);
        }
      }
    }
  }
  .zine .cover-art {
      aspect-ratio: 21/7;
    }
  }
  /* Risograph cover: the still is grayscaled, then an orange ink layer with a
     dot screen multiplies over it (duotone + halftone). The scrim stays so the
     numeral and badge remain readable. */
  .zine .cover-art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to bottom, rgba(13, 10, 5, 0.78), rgba(13, 10, 5, 0.32) 45%, rgba(13, 10, 5, 0.6)),
      var(--thumb-max), var(--thumb-hq);
    background-position: center;
    background-size: cover;
    filter: grayscale(1) contrast(1.12) brightness(0.92);
    transition: transform 0.6s ease;
  }
  .zine .cover-art::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: var(--color-brand-500);
    background-image: radial-gradient(circle, rgba(0, 0, 0, 0.18) 0.9px, transparent 1px);
    background-size: 4px 4px;
    mix-blend-mode: multiply;
    opacity: 0.88;
    transition: opacity 0.6s ease;
  }
  .zine .cover:hover .cover-art::before {
    transform: scale(1.04);
  }
  .zine .cover:hover .cover-art::after {
    opacity: 1;
  }
  .zine .cover-art > * {
    position: relative;
    z-index: 1;
  }
  /* ---- carimbo (selo rotacionado) ---- */
  .zine .cover-art .stamp {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    width: 7.5rem;
    height: 7.5rem;
    transform: rotate(-8deg);
    color: var(--color-brand-500);
    transition: transform 0.3s ease, color 0.15s;
  }
  .zine .cover-art .stamp:hover {
    transform: rotate(-4deg) scale(1.06);
    color: var(--color-brand-400);
  }
  .zine .cover-art .stamp svg {
    width: 100%;
    height: 100%;
  }
  .zine .cover-art .stamp text {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: currentColor;
  }
  .zine .cover-art .n {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(4rem, 12vw, 8.5rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 2px rgba(13, 10, 5, 0.55), 0 2px 14px rgba(13, 10, 5, 0.55);
  }
  .zine .cover-art .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #fff;
    background: var(--color-brand-500);
    padding: 0.4rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    transition: background 0.15s;
  }
  .zine .cover-art .badge:hover {
    background: var(--color-brand-400);
  }
  /* Stretched link: the badge anchor paints an invisible layer over the whole
     artwork so the entire cover is clickable. The stamp sits at z-index 2 and
     keeps its own hit area; both point at the same episode URL. */
  .zine .cover-art .badge::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .zine .cover .figcap {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .zine .lead {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }
  .zine .lead .kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-muted);
    margin-bottom: 0.35rem;
  }
  .zine .lead h2 {
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(2rem, 4vw, 3rem);
    text-wrap: balance;
  }
  .zine .lead .deck {
    margin-top: 1rem;
    max-width: 38rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  /* drop cap (detalhe de impresso) */
  .zine .lead .deck::first-letter {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3.2em;
    line-height: 0.8;
    float: left;
    padding: 0.06em 0.1em 0 0;
    color: var(--color-brand-400);
  }
  .zine .lead .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dotted var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .zine .lead .facts b {
    color: var(--color-on-background);
    font-weight: 500;
  }
  .zine .lead .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    align-items: center;
  }
  .zine .link-arrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-brand-400);
  }
  .zine .link-arrow:hover {
    text-decoration: underline;
  }

  /* ---- colophon (terminal + signatures) ---- */
  .zine .colofao {
    border-top: 1px solid var(--color-border);
    padding-block: 3.5rem;
  }
  .zine .colofao .wrap {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .zine .colofao .wrap {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ---- terminal (colophon) ---- */
  .zine .colophon {
    background: var(--term);
    border: 1px solid var(--term-line);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .zine .colophon .h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--term-line);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.7rem;
  }
  .zine .colophon .h .dots {
    display: flex;
    gap: 0.4rem;
  }
  .zine .colophon .h .dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--term-line);
    font-style: normal;
  }
  .zine .colophon .h .dots i.o {
    background: var(--color-brand-500);
  }
  .zine .colophon .b {
    padding: 1.1rem 1rem;
    color: var(--color-muted);
  }
  .zine .colophon .b .cmd {
    color: var(--color-on-background);
  }
  .zine .colophon .b .cmd .p {
    color: var(--color-brand-400);
  }
  .zine .colophon .b .sep {
    height: 1px;
    background: var(--term-line);
    margin: 0.9rem 0;
  }
  .zine .colophon .b .f {
    color: var(--color-brand-400);
  }
  .zine .colophon .b .f + p {
    margin-top: 0.25rem;
    padding-left: 1rem;
  }
  .zine .colophon .b .ep a {
    color: var(--color-on-background);
    transition: color 0.15s;
  }
  .zine .colophon .b .ep a:hover {
    color: var(--color-brand-400);
  }
  .zine .colophon .b p + .f {
    margin-top: 0.9rem;
  }
  .zine .colophon .cap {
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--term-line);
    color: var(--color-muted);
    font-size: 0.7rem;
    display: flex;
    justify-content: space-between;
  }
  .zine .colophon .cap .led {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-brand-500);
    margin-right: 0.45rem;
  }

  /* ---- assinaturas ---- */
  .zine .subs {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1.25rem;
    text-wrap: pretty;
  }
  /* Anchored sections should not land flush against the viewport edge. */
  .zine section[id] {
    scroll-margin-top: 1.5rem;
  }
  .zine .subs ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }
  .zine .subs a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
    border-bottom: 1px dotted var(--color-border);
    padding-bottom: 0.6rem;
    transition: color 0.15s;
  }
  .zine .subs a:hover {
    color: var(--color-brand-400);
  }
  .zine .subs a .go {
    color: var(--color-brand-500);
  }
  .zine .subs .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .zine .subs .stats b {
    color: var(--color-on-background);
  }

  /* ---- sections ---- */
  :global(.js) .zine .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  :global(.js) .zine .reveal.in {
    opacity: 1;
    transform: none;
  }
  /* headings rise out of a mask as the section enters */
  :global(.js) .zine .reveal h2,
  :global(.js) .zine .reveal .eyebrow {
    clip-path: inset(0 0 100% 0);
    transform: translateY(0.45em);
    padding-bottom: 0.06em;
    transition: clip-path 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.08s,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.08s;
  }
  :global(.js) .zine .reveal.in h2,
  :global(.js) .zine .reveal.in .eyebrow {
    clip-path: inset(0);
    transform: none;
  }
  /* grids cascade in (animation, not transition: keeps the hover) */
  :global(.js) .zine .reveal.in :is(.eps, .hosts-grid) > * {
    animation: dg-rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  :global(.js) .zine .reveal.in :is(.eps, .hosts-grid) > *:nth-child(1) {
    animation-delay: 0.06s;
  }
  :global(.js) .zine .reveal.in :is(.eps, .hosts-grid) > *:nth-child(2) {
    animation-delay: 0.13s;
  }
  :global(.js) .zine .reveal.in :is(.eps, .hosts-grid) > *:nth-child(3) {
    animation-delay: 0.2s;
  }
  :global(.js) .zine .reveal.in :is(.eps, .hosts-grid) > *:nth-child(4) {
    animation-delay: 0.27s;
  }
  @keyframes dg-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .zine section.block {
    border-top: 1px solid var(--color-border);
    padding-block: 3.5rem;
  }
  @media (min-width: 640px) {
    .zine section.block {
      padding-block: 4.5rem;
    }
  }
  .zine .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-on-background);
    padding-bottom: 0.75rem;
  }
  .zine .sec-head h2 {
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    text-wrap: balance;
  }
  /* Axis jump on the biggest display type. No transition on purpose: the
     reveal rules already own `transition` on these headings. */
  .zine .sec-head h2:hover {
    font-variation-settings: 'wght' 780, 'WONK' 1;
  }
  /* Outlined numerals: one per headed section, counter bumped on the head so
     headless sections never consume a number. */
  .zine .sec-head {
    counter-increment: dg-sec;
  }
  .zine .sec-head .eyebrow::before {
    content: counter(dg-sec, decimal-leading-zero);
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-brand-500);
    opacity: 0.6;
  }
  .zine .sec-head .eyebrow {
    margin-bottom: 0.35rem;
  }

  /* Inverted (paper) block: a light print sheet breaking the dark run.
     Flipping --color-on-background to ink makes every hairline/title inside
     invert on its own; surfaces stay dark, so cards read as ink on paper. */
  .zine section.block.inverted {
    --color-on-background: var(--color-background);
    --color-on-surface: var(--color-background);
    --color-muted: #6b635a;
    --color-border: #d9d2c6;
    /* Notebook grid, so the paper block reads as a printed page. */
    background-color: #f3efe9;
    background-image:
      repeating-linear-gradient(to right, rgb(13 10 5 / 0.06) 0 1px, transparent 1px 2rem),
      repeating-linear-gradient(to bottom, rgb(13 10 5 / 0.06) 0 1px, transparent 1px 2rem);
    color: var(--color-background);
  }
  /* Cards inside the paper block stay ink-dark, so they flip the tokens back
     and set their own color (the section's black is inherited, not a var). */
  .zine section.block.inverted .edition {
    --color-on-background: #f3efe9;
    --color-on-surface: #e7e2da;
    --color-muted: #a49c90;
    --color-border: #2e2923;
    color: var(--color-on-background);
  }

  /* ---- table of contents ---- */
  .zine .toc-big {
    border-bottom: 1px solid var(--color-border);
  }
  .zine .toc-big .row {
    display: grid;
    gap: 0.5rem 1.5rem;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-border);
    transition: background 0.15s;
  }
  .zine .toc-big .row:hover {
    background: var(--color-surface);
  }
  .zine .toc-big .num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2rem;
    color: var(--color-brand-500);
    line-height: 1;
  }
  .zine .toc-big .mid h3 {
    font-weight: 600;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
  }
  .zine .toc-big .mid p {
    margin-top: 0.4rem;
    max-width: 34rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .zine .toc-big .pg {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .zine .toc-big .pg u {
    border-bottom: 1px dotted var(--color-muted);
    display: inline-block;
    min-width: 6rem;
    text-decoration: none;
    margin-right: 0.6rem;
  }
  @media (min-width: 1024px) {
    .zine .toc-big .pg {
      display: block;
    }
  }

  /* ---- pull quote ---- */
  .zine .pullquote {
    border-top: 2px solid var(--color-on-background);
    border-bottom: 2px solid var(--color-on-background);
    padding-block: 2.75rem;
    text-align: center;
    margin-top: 2.5rem;
  }
  .zine .pullquote p {
    font-weight: 600;
    font-variation-settings: 'wght' 600;
    transition: font-variation-settings 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 46rem;
    margin-inline: auto;
    text-wrap: balance;
  }
  /* Variable-font axis play: the full Fraunces build exposes wght, SOFT and
     WONK, so hover gains weight and swaps in the "wonky" alternates. */
  .zine .pullquote p:hover {
    font-variation-settings: 'wght' 780, 'SOFT' 40, 'WONK' 1;
  }
  .zine .pullquote .qm {
    display: block;
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 0;
    color: var(--color-brand-500);
    margin-bottom: 1.1rem;
  }
  .zine .pullquote .src {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-muted);
  }
  .zine .pullquote .pick {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .zine .pullquote .pick a {
    color: var(--color-brand-400);
    transition: color 0.15s;
  }
  .zine .pullquote .pick a:hover {
    color: var(--color-brand-500);
  }

  /* ---- episodes ---- */
  .zine .eps {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .zine .eps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .zine .eps {
      /* Bento-ish: uneven cells instead of four identical boxes. */
      grid-template-columns: repeat(6, 1fr);
    }
    .zine .eps > :first-child {
      grid-column: span 3;
    }
    .zine .eps > :nth-child(2) {
      grid-column: span 3;
    }
    .zine .eps > :nth-child(3) {
      grid-column: span 2;
    }
    .zine .eps > :nth-child(4) {
      grid-column: span 4;
    }
  }
  .zine .ep {
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Hard offset shadow reads as a sticker stuck on the page. */
    box-shadow: 5px 5px 0 var(--color-brand-500);
    transition: background 0.15s, transform 0.2s, box-shadow 0.2s;
  }
  .zine .ep:hover {
    background: var(--color-background);
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--color-brand-500);
  }
  /* Washi tape over the thumb. It lives inside the card because the card
     clips its own overflow. */
  .zine .ep::before {
    content: '';
    position: absolute;
    top: 0.55rem;
    left: 0.9rem;
    z-index: 1;
    width: 3.25rem;
    height: 1.05rem;
    background: rgb(236 103 55 / 0.55);
    transform: rotate(-4deg);
    pointer-events: none;
  }
  .zine .ep .art {
    aspect-ratio: 16/9;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid var(--color-border);
  }
  .zine .ep .body {
    padding: 1rem;
    display: flex;
