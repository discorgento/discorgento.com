  /* ---- episode player (modal) ---- */
  .ep-modal {
    /* Size explicitly: never rely on the UA's fit-content for a dialog whose
       only child is an absolutely positioned iframe (that collapses to 0).
       height must be resolved (fit-content): with inset:0 and height:auto the
       box stretches to the full viewport instead of hugging the video. */
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 56rem;
    height: fit-content;
    max-height: 100dvh;
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border);
    background: #000;
  }
  .ep-modal::backdrop {
    background: rgb(13 10 5 / 85%);
  }
  .ep-modal-frame {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .ep-modal-frame iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .ep-modal-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--color-on-background);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    cursor: pointer;
  }
  .ep-modal-close:hover,
  .ep-modal-close:focus-visible {
    color: var(--color-brand-400);
    border-color: var(--color-brand-500);
  }

  /* ---- toast (copiar convite) ---- */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    z-index: 70;
    transform: translate(-50%, 0.75rem);
    opacity: 0;
    visibility: hidden;
    padding: 0.6rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-on-background);
    background: var(--color-surface);
    border: 1px solid var(--color-brand-500);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .toast.on {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  /* ---- movimento reduzido ---- */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .zine .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    :global(.js) .zine .reveal h2,
    :global(.js) .zine .reveal .eyebrow {
      clip-path: none;
      transform: none;
      transition: none;
    }
    :global(.js) .zine .reveal.in :is(.eps, .hosts-grid) > * {
      animation: none;
    }
    .toast {
      transform: translate(-50%, 0);
      transition: opacity 0.2s ease, visibility 0.2s;
    }
    .zine .cover-art::before,
    .zine .cover-art::after,
    .zine .ep .go,
    .zine .cover-art .stamp,
    .zine .host .rule,
    .zine .host .s,
    .zine .host .see {
      transition: none;
    }
    .zine .cover:hover .cover-art::before,
    .zine .ep:hover .go {
      transform: none;
    }
    /* The load-in choreography (cover wipe) is motion, so it goes. */
    .zine .cover-art,
    .zine .btn:not(.ghost),
    .zine .ep {
      animation: none;
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  document.documentElement.classList.add('js');

  function initReveal() {
    const items = document.querySelectorAll('.zine .reveal:not([data-reveal-ready])');
    if (!items.length) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || !('IntersectionObserver' in window)) {
      items.forEach((el) => {
        el.setAttribute('data-reveal-ready', '');
        el.classList.add('in');
      });
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
    );
    items.forEach((el) => {
      el.setAttribute('data-reveal-ready', '');
      observer.observe(el);
    });
  }

  const scope = window as unknown as Record<string, unknown>;

  if (!scope.__dgHome) {
    scope.__dgHome = true;

    let toastTimer = 0;

    function showToast(message: string) {
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('on');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('on'), 2400);
    }

    const modal = () =>
      document.querySelector<HTMLDialogElement>('[data-ep-modal]');

    document.addEventListener('click', async (event) => {
      const target = event.target as Element | null;
      if (!target || !target.closest) return;

      // copiar convite do Discord
      const copier = target.closest<HTMLElement>('[data-copy]');
      if (copier) {
        const value = copier.getAttribute('data-copy') ?? '';
        const toast = document.querySelector('[data-toast]');
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          /* clipboard bloqueado: avisa mesmo assim */
        }
        showToast(toast?.getAttribute('data-copied') ?? '');
        return;
      }

      // fechar o player
      if (target.closest('[data-player-close]')) {
        modal()?.close();
        return;
      }

      // open the episode in the player instead of leaving the site
      const card = target.closest('.zine .ep');
      if (card) {
        const id = (card.getAttribute('href') ?? '').match(/(?:v=|youtu\.be\/|embed\/)([\w-]{6,})/)?.[1];
        const dialog = modal();
        const frame = dialog?.querySelector('[data-ep-frame]');
        if (!id || !dialog || !frame) return;
        event.preventDefault();
        frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" style="position:absolute;inset:0;width:100%;height:100%;border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        const iframe = frame.querySelector('iframe');
        if (iframe) {
          const label = card.querySelector('.title')?.textContent?.trim();
          iframe.setAttribute('title', label || 'YouTube');
        }
        dialog.showModal();
        return;
      }

      // clique no backdrop fecha
      const opened = modal();
      if (opened?.open && event.target === opened) opened.close();
    });

    // the close event does not bubble: capture it so the iframe (and audio) is torn down
    document.addEventListener(
      'close',
      (event) => {
        const dialog = event.target as HTMLDialogElement | null;
        if (dialog?.matches?.('[data-ep-modal]')) {
          const frame = dialog.querySelector('[data-ep-frame]');
          if (frame) frame.innerHTML = '';
        }
      },
      true
    );
  }

  document.addEventListener('astro:page-load', initReveal);
  initReveal();
</script>