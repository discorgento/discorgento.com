---
import type { Video } from '~/lib/youtube';
import { getLatestVideos, episodeNum } from '~/lib/youtube';
import { useTranslations, intlLocale } from '~/lib/i18n';
import YouTubeStamp from '~/components/YouTubeStamp.astro';
import EpisodeArt from '~/components/EpisodeArt.astro';

interface Props {
  locale: string;
  videos?: Video[];
}

/* The podcast page episode list, rendered two ways by the same component:
 *
 *  - The `server:defer` island render: `Astro.props.videos` is absent, so this
 *    fetches the channel live at request time — new episodes appear without a
 *    redeploy.
 *  - The `slot="fallback"` render (with `videos`): the build-time videos from
 *    PodcastPage (which still needs them for the PodcastSeries JSON-LD).
 */
const { locale } = Astro.props;
const videos = Astro.props.videos ?? (await getLatestVideos());
const t = useTranslations(locale);

if (Astro.props.videos === undefined) {
  /* Deliberate no-store, matching LatestEdition: the island is per-view data,
     not a cacheable asset. The YouTube feed request is edge-cached
     (cf.cacheTtl in youtube.ts), so this does not hammer the publication. */
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// UTC so the visible date and the machine-readable datetime below can never
// disagree: the build machine's timezone otherwise decides which day "22:30Z"
// falls on, and `isoDate` is always UTC.
const dateFormatter = new Intl.DateTimeFormat(intlLocale(locale), {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

// The mark text is site copy, so it follows the locale like everything else.
const stampText = t('episodes.stamp');

function formatDate(published: string): string {
  try {
    return dateFormatter.format(new Date(published));
  } catch {
    return '';
  }
}

// Normalizes whatever the feed handed us into a plain YYYY-MM-DD for the
// datetime attribute. Returns '' on an unparseable value so a bad feed entry
// degrades to plain text instead of emitting <time datetime="Invalid Date">.
function isoDate(published: string): string {
  const d = new Date(published);
  return Number.isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 10);
}
---

<div class="border-b border-border">
  {videos.length === 0 ? (
    <p class="py-10 text-center font-mono text-xs text-muted/85">
      {t('podcast.empty')}
    </p>
  ) : (
    videos.map((v) => {
      const num = episodeNum(v.title);
      const date = formatDate(v.published);
      const iso = isoDate(v.published);
      return (
        <a
          href={v.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group grid gap-3 border-t border-border py-6 transition hover:bg-surface md:grid-cols-[4rem_8rem_1fr_auto] md:items-center md:gap-6"
        >
          <span class="font-mono text-sm text-brand-500">{num ? `#${num}` : '● ep'}</span>
          <span class="relative block w-full md:w-32">
            {/* Empty alt: the thumbnail repeats the episode title that sits
                right next to it. Labelling both made the link announce its
                target twice — worse once the title below became a real h3. */}
              <EpisodeArt
                id={v.id}
                alt=""
                imgClass="aspect-video w-full border border-border object-cover"
                sizes="(min-width: 768px) 8rem, 90vw"
              />
            <YouTubeStamp
              uid={`ep-${v.id}`}
              class="absolute right-1.5 top-1.5 z-10"
            >
              {stampText}
            </YouTubeStamp>
          </span>
          <span class="block">
            {/* h3, not a styled span: the page goes h1 (podcast) > h2 (platform
                block) > h3 (episode), which is what lets a screen reader or an
                agent enumerate the episodes instead of reading a flat list. */}
            <h3 class="text-balance font-display text-xl font-semibold tracking-tight text-on-background transition group-hover:text-brand-400">
              {v.title}
            </h3>
            {/* Wrapped in <time datetime> so the date is machine-readable. The
                formatted text alone ("10 de out. de 2023") has to be re-parsed,
                and its day/month order is a guess for anything that is not a
                pt-BR reader. No visual change — the text is unchanged. */}
            <span class="mt-1 block font-mono text-xs text-muted">
              {iso && date ? <><time datetime={iso}>{date}</time> · </> : null}
              youtube
            </span>
          </span>          <span class="hidden font-mono text-sm text-muted transition group-hover:text-brand-400 md:block">
            →
          </span>
        </a>
      );
    })
  )}
</div>