---
import { useTranslations } from '~/lib/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const discordUrl = 'https://discorgento.com/discord';
const githubUrl = 'https://github.com/discorgento';
const googlePolicyUrl = 'https://policies.google.com/privacy';
---

<section class="border-b-2 border-on-background py-10 sm:py-20">
  <p class="eyebrow mb-3 sm:mb-4">
    <span class="text-brand-500">●</span> {t('privacy.eyebrow')}
  </p>
  <h1 class="font-display text-3xl font-black tracking-tight text-on-background sm:text-5xl">
    {t('privacy.title')}
  </h1>
  <p class="mt-3 max-w-2xl leading-relaxed text-muted sm:mt-4">{t('privacy.desc')}</p>
  <p class="mt-5 font-mono text-xs uppercase tracking-wider text-muted sm:mt-6">{t('privacy.updated')}</p>
</section>

<section class="py-10 sm:py-14">
  <div class="max-w-2xl space-y-7 sm:space-y-10">
    <div>
      <h2 class="font-display text-2xl font-black tracking-tight text-on-background">
        {t('privacy.measure.title')}
      </h2>
      <p class="mt-3 leading-relaxed text-on-background/80">{t('privacy.measure.body')}</p>
    </div>

    <div>
      <h2 class="font-display text-2xl font-black tracking-tight text-on-background">
        {t('privacy.not.title')}
      </h2>
      <p class="mt-3 leading-relaxed text-on-background/80">{t('privacy.not.body')}</p>
    </div>

    <div>
      <h2 class="font-display text-2xl font-black tracking-tight text-on-background">
        {t('privacy.choice.title')}
      </h2>
      <p class="mt-3 leading-relaxed text-on-background/80">{t('privacy.choice.body')}</p>
      {/* Any [data-consent-settings] anywhere reopens the banner, so the visitor
          can withdraw consent right here instead of hunting for the footer. */}
      <button
        type="button"
        data-consent-settings
        class="mt-4 border-2 border-muted px-5 py-2.5 font-mono text-xs uppercase tracking-wider text-on-background transition hover:border-brand-500 hover:text-brand-400"
      >
        {t('privacy.choice.button')}
      </button>
    </div>

    <div>
      <h2 class="font-display text-2xl font-black tracking-tight text-on-background">
        {t('privacy.sharing.title')}
      </h2>
      <p class="mt-3 leading-relaxed text-on-background/80">{t('privacy.sharing.body')}</p>
      <p class="mt-2">
        <a
          href={googlePolicyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-400 underline underline-offset-4 transition hover:text-brand-300"
        >
          {t('privacy.sharing.link')} ↗
        </a>
      </p>
    </div>

    <div>
      <h2 class="font-display text-2xl font-black tracking-tight text-on-background">
        {t('privacy.contact.title')}
      </h2>
      <p class="mt-3 leading-relaxed text-on-background/80">{t('privacy.contact.body')}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a
          href={discordUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-border px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-muted transition hover:border-brand-500 hover:text-brand-400"
        >
          Discord ↗
        </a>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-border px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-muted transition hover:border-brand-500 hover:text-brand-400"
        >
          GitHub ↗
        </a>
      </div>
    </div>
  </div>
</section>
