---
/**
 * The "watch on YouTube" mark.
 *
 * Two variants, because a circular textPath has a hard legibility floor: the
 * glyphs ride a 100-unit circumference, so once the seal drops to ~60px every
 * letter is only a few pixels tall and reads as a red ring.
 *
 * - `seal` — circular, rotated, for the hero cover where there is room.
 * - `pill` — straight baseline, for episode cards and list rows. The text stays
 *   horizontal so it holds at any size an agent or low-vision user sees.
 *
 * Decorative by default (`aria-hidden`). The episode card is the actionable
 * element and already names the platform in its own text, so the mark never
 * needs a second accessible name. Pass `label` only when the mark is the sole
 * route to the video.
 */
interface Props {
  variant?: 'seal' | 'pill';
  label?: string;
  /** `uid` must be unique per page: textPath resolves by document id. */
  uid: string;
  class?: string;
}

const { variant = 'pill', label, uid, class: className = '' } = Astro.props;
const pathId = `yt-stamp-path-${uid}`;
---

{
  variant === 'seal' ? (
    <span class={`yt-seal ${className}`} aria-hidden={label ? undefined : 'true'}>
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.7" />
        <circle cx="50" cy="50" r="33" fill="none" stroke="currentColor" stroke-width="1.9" />
        <defs>
          <path id={pathId} d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0" />
        </defs>
        <slot name="text">
          <text font-size="9.5"><textPath href={`#${pathId}`}>assistir no youtube</textPath></text>
        </slot>
      </svg>
    </span>
  ) : (
    <span class={`yt-pill ${className}`} aria-hidden={label ? undefined : 'true'}>
      <svg class="play" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
        <path d="M1 0.6 L9 5 L1 9.4 Z" fill="currentColor" />
      </svg>
      <span class="txt"><slot>youtube</slot></span>
    </span>
  )
}

<style>
  /* YouTube red with a neutral black shadow: the mark names an external
     platform, so it wears that platform's colour, but the glow stays black to
     lift it off the thumbnail without tinting it. */
  .yt-seal,
  .yt-pill {
    color: var(--color-youtube);
    filter: drop-shadow(0 1px 2px rgba(13, 10, 5, 0.9)) drop-shadow(0 2px 10px rgba(13, 10, 5, 0.7));
  }

  .yt-seal {
    display: inline-block;
    width: 7.5rem;
    height: 7.5rem;
    transform: rotate(-8deg);
    transition: transform 0.3s ease, filter 0.2s;
  }
  .yt-seal svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .yt-seal :global(text) {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    fill: currentColor;
  }

  .yt-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.5rem;
    /* Opaque plate: at 10px the red text needs a fully dark backing to clear
       AA (4.99:1). A translucent plate drops to 3:1 over a near-white
       thumbnail, which is exactly the readability problem this replaces. */
    background: var(--color-background);
    box-shadow: inset 0 0 0 1px rgba(255, 0, 51, 0.6);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    transition: transform 0.2s ease, filter 0.2s;
  }
  .yt-pill .play {
    width: 0.6875rem;
    height: 0.6875rem;
    flex: none;
  }

  :global(a:hover) .yt-seal,
  :global(a:hover) .yt-pill {
    transform: rotate(-4deg) scale(1.06);
    filter: drop-shadow(0 1px 2px rgba(13, 10, 5, 0.95)) drop-shadow(0 3px 18px rgba(13, 10, 5, 0.85));
  }

  @media (prefers-reduced-motion: reduce) {
    .yt-seal,
    .yt-pill {
      transition: none;
    }
  }
</style>