---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '~/lib/i18n';
import type { ResolvedMember } from '~/lib/team';

interface Props {
  locale: string;
  hosts: ResolvedMember[];
}

const { locale, hosts } = Astro.props;
const t = useTranslations(locale);
---

<!-- TEAM (who makes it) -->
<section class="block reveal halftone" id="quem-faz">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow"><span class="o">●</span> {t('home.hosts.eyebrow')}</p>
        <h2>{t('home.hosts.title')}</h2>
      </div>
      <a class="link-arrow" href={getRelativeLocaleUrl(locale, '/quem-faz')}>
        {t('home.hosts.all')} →
      </a>
    </div>
    <p class="hosts-note">{t('home.hosts.desc')}</p>
    <div class="hosts-grid">
      {hosts.map((person, index) => (
        <article class="host">
          <a class="ph" href={person.profile} target="_blank" rel="noopener noreferrer">
            {person.photo ? (
              <img
                class="face"
                src={person.photo}
                alt=""
                width="400"
                height="400"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="face monogram" aria-hidden="true">{person.initials}</span>
            )}
            <span class="idx" aria-hidden="true">0{index + 1}</span>
            <span class="see">
              <span class="sr-only">{person.name}, </span>{t('home.hosts.profile')}
              <span aria-hidden="true"> ↗</span>
            </span>
          </a>
          <div class="who">
            <h3>{person.name}</h3>
            <span class="rule" aria-hidden="true"></span>
            <p class="role">{person.role}</p>
            <div class="socials">
              {person.socials.map((social) => (
                <a
                  class="s"
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${person.name}, ${social.label}`}
                >
                  {social.label} <span class="ext" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Anchored sections should not land flush against the viewport edge. */
  :global(.zine) section[id] {
    scroll-margin-top: 1.5rem;
  }

  /* ---- team (who makes it) — cover cards ---- */
  :global(.zine) .hosts-note {
    margin-top: 0.5rem;
    max-width: 34rem;
    font-size: 0.95rem;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  :global(.zine) section.halftone {
    /* Halftone dot field: the print texture the risograph cover uses, kept
       faint so it stays a backdrop. */
    background-image: radial-gradient(circle, rgb(236 103 55 / 0.1) 1px, transparent 1.2px);
    background-size: 14px 14px;
    background-position: center;
  }
  :global(.zine) .hosts-grid {
    display: grid;
    /* Two up on a phone. auto-fit with a 13.5rem floor can only place one track
       below ~450px, so each 1:1 photo took the full 334px and four of them stacked
       into 1900px of scrolling. The square shape stays; the size does not. */
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    margin-top: 1.75rem;
  }
  @media (min-width: 768px) {
    :global(.zine) .hosts-grid {
      /* Four across on desktop, which is the whole roster in one row. */
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* grids cascade in (animation, not transition: keeps the hover) — the
     episodes grid running the same cascade lives in HomeEpisodes.astro */
  :global(.js .zine) .reveal.in .hosts-grid > * {
    animation: dg-rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  :global(.js .zine) .reveal.in .hosts-grid > *:nth-child(1) {
    animation-delay: 0.06s;
  }
  :global(.js .zine) .reveal.in .hosts-grid > *:nth-child(2) {
    animation-delay: 0.13s;
  }
  :global(.js .zine) .reveal.in .hosts-grid > *:nth-child(3) {
    animation-delay: 0.2s;
  }
  :global(.js .zine) .reveal.in .hosts-grid > *:nth-child(4) {
    animation-delay: 0.27s;
  }
  @keyframes dg-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(.zine) .host {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    transition: background 0.2s;
  }
  :global(.zine) .host:hover {
    background: var(--color-surface-raised);
  }
  :global(.zine) .host .ph {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1/1;
    border-bottom: 1px solid var(--color-border);
  }
  :global(.zine) .host .ph .face {
    width: 100%;
    height: 100%;
    /* Slow push-in on hover, same easing as the episode thumbnails so the whole
       page answers a hover the same way. */
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.zine) .host:hover .ph .face {
    transform: scale(1.05);
  }
  /* ---- Tear on hover: the mark's glitch, generalised to any container ----
     The logo needs a masked ghost because the mark is one SVG. Everywhere else
     the same read comes from a clip-path band laid over the content. This only
     works on real elements, not replaced ones — pseudo-elements on an <img> are
     unreliable in Firefox, which is why the logo markup uses sibling spans.
     (The episodes grid runs the same tear inside HomeEpisodes.astro.) */
  :global(.zine) .host .ph::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-color: var(--color-on-background);
    opacity: 0;
    clip-path: inset(30% 0 44% 0);
    will-change: transform, clip-path, opacity;
  }
  :global(.zine) .host:hover .ph::after {
    animation: 0.42s steps(3, end) dg-tear both;
  }
  @keyframes dg-tear {
    0% {
      opacity: 0;
      transform: none;
      clip-path: inset(30% 0 44% 0);
    }
    33% {
      opacity: 0.85;
      transform: translateX(-0.5rem);
      clip-path: inset(42% 0 30% 0);
    }
    66% {
      opacity: 0.6;
      transform: translateX(0.35rem);
      clip-path: inset(18% 0 56% 0);
    }
    100% {
      opacity: 0;
      transform: none;
      clip-path: inset(30% 0 44% 0);
    }
  }
  :global(.zine) .host .ph .face.monogram {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3rem;
    color: var(--color-muted);
  }
  :global(.zine) .host .idx {
    position: absolute;
    top: 0.65rem;
    left: 0.75rem;
    z-index: 1;
    padding: 0.15rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--color-background);
    background: var(--color-brand-500);
  }
  :global(.zine) .host .see {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-background);
    background: var(--color-brand-500);
    transform: translateY(101%);
    transition: transform 0.25s ease;
  }
  :global(.zine) .host .ph:hover .see,
  :global(.zine) .host .ph:focus-visible .see {
    transform: none;
  }
  :global(.zine) .host .who {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.25rem 1.35rem;
  }
  :global(.zine) .host h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  :global(.zine) .host .rule {
    display: block;
    width: 0;
    height: 2px;
    margin-top: 0.5rem;
    background: var(--color-brand-500);
    transition: width 0.35s ease;
  }
  :global(.zine) .host:hover .rule {
    width: 2.5rem;
  }
  :global(.zine) .host .role {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
  }
  :global(.zine) .host .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  /* 24px minimum touch target, per WCAG 2.5.8. Padding does that without
     touching the type size the zine depends on. */
  :global(.zine) .host .s {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 1.5rem;
    min-width: 1.5rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    transition: border-color 0.15s, color 0.15s;
  }
  :global(.zine) .host .s:hover {
    border-color: var(--color-brand-500);
    color: var(--color-brand-400);
  }
  :global(.zine) .host .s .ext {
    font-size: 0.85em;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.zine) .host .ph {
      animation: none;
    }
    :global(.js .zine) .reveal.in .hosts-grid > * {
      animation: none;
    }
    :global(.zine) .host .rule,
    :global(.zine) .host .s,
    :global(.zine) .host .see,
    :global(.zine) .host .ph .face {
      transition: none;
    }
    :global(.zine) .host:hover .ph .face {
      transform: none;
    }
  }

  /* Mobile tap target: see the note on the overlay technique in Home. */
  @media (max-width: 639px) {
    :global(.zine) .host .s {
      position: relative;
    }
    :global(.zine) .host .s::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 44px;
      transform: translateY(-50%);
    }
  }
</style>
