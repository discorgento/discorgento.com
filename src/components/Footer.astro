---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '~/lib/i18n';

const locale = Astro.currentLocale ?? 'pt-BR';
const t = useTranslations(locale);
const homeUrl = getRelativeLocaleUrl(locale, '/');
const discordUrl = 'https://discorgento.com/discord';
const githubUrl = 'https://github.com/discorgento';
const youtubeUrl = 'https://www.youtube.com/@discorgento';
const spotifyUrl = 'https://open.spotify.com/playlist/4pU2Abae7J8vdY4yqPCXRc';
const substackUrl = 'https://discorgento.substack.com';
const twitterUrl = 'https://twitter.com/discorgento';
---

<footer class="mt-16 border-t-2 border-on-background bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-xs">
        <a href={homeUrl} class="flex items-center gap-1.5 py-2.5 -my-2.5">
          <img src="/img/logo.svg" alt="" class="h-5 w-5" width={20} height={20} />
          <span class="font-display text-xl font-extrabold lowercase tracking-tight text-on-background">
            discorgento
          </span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-muted">{t('footer.description')}</p>
      </div>
      <div class="font-mono text-sm">
        <p class="eyebrow mb-4">
          <span class="text-brand-500">●</span> {t('footer.social')}
        </p>
        <ul class="space-y-8">
          <li>
            <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="py-3.5 text-muted transition hover:text-brand-400">
              discorgento.com/discord
            </a>
          </li>
          <li>
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="py-3.5 text-muted transition hover:text-brand-400">
              github.com/discorgento
            </a>
          </li>
          <li>
            <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="py-3.5 text-muted transition hover:text-brand-400">
              youtube.com/@discorgento
            </a>
          </li>
          <li>
            <a href={spotifyUrl} target="_blank" rel="noopener noreferrer" class="py-3.5 text-muted transition hover:text-brand-400">
              open.spotify.com/discorgento
            </a>
          </li>
          <li>
            <a href={substackUrl} target="_blank" rel="noopener noreferrer" class="py-3.5 text-muted transition hover:text-brand-400">
              discorgento.substack.com
            </a>
          </li>
          <li>
            <a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="py-3.5 text-muted transition hover:text-brand-400">
              twitter.com/discorgento
            </a>
          </li>
        </ul>
      </div>
    </div>
    <!-- Decorative wordmark. Drawn from a pseudo-element so it stays out of the a11y tree
         and out of the contrast audit: it is a texture, not content. -->
    <div class="footer-wordmark" aria-hidden="true"></div>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-2 border-t border-white/10 pt-6">
      <p class="font-mono text-xs text-muted/85">© {new Date().getFullYear()} discorgento</p>
      <p class="font-mono text-xs text-muted/85">{t('footer.since')}</p>
      <p class="font-mono text-xs text-muted/85">magento · vtex · shopify · bigcommerce · php · js · [+etc]</p>
    </div>
  </div>
</footer>

<style>
  .footer-wordmark {
    margin-block-start: 3.5rem;
    overflow-x: clip;
    pointer-events: none;
    user-select: none;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.02em;
    font-size: clamp(2.5rem, 12.5vw, 10.5rem);
    color: color-mix(in srgb, var(--color-on-background) 4%, transparent);
  }

  .footer-wordmark::after {
    content: 'discorgento';
  }
</style>