---
import { useTranslations } from '~/lib/i18n';
import { getLatestSubstackPosts } from '~/lib/substack';
import { formatEpDate } from '~/lib/youtube';

const SUBSTACK_URL = 'https://discorgento.substack.com';

interface Props {
  locale: string;
}

/* The locale arrives as a prop, like the other islands. A server island renders
   outside the page request (Astro.url here is /_server-islands/LatestEdition), and
   it used to recover the locale from the Referer header instead — which silently
   fell back to pt-BR whenever a browser or privacy extension trimmed the header. */
const { locale } = Astro.props;
const t = useTranslations(locale);

/* Deliberate no-store, matching the other islands: per-view data, not a
   cacheable asset. The Substack side stays cheap because the feed request is
   edge-cached (cf.cacheTtl in substack.ts), not because this response is. */
Astro.response.headers.set('Cache-Control', 'no-store');

/* Read at request time. A post published on Substack shows up here on the next
   (uncached) view, with no redeploy. */
const [latestPost] = await getLatestSubstackPosts(1);
---

<a
  href={latestPost ? latestPost.url : SUBSTACK_URL}
  target="_blank"
  rel="noopener noreferrer"
  class="edition"
>
  <p class="meta">
    <span class="tag">{t('home.newsletter.tag')}</span>
    {latestPost && <span class="date">{formatEpDate(latestPost.published, locale)}</span>}
  </p>
  <h3>{latestPost ? latestPost.title : t('home.newsletter.empty')}</h3>
  <p class="go">
    {latestPost ? `${t('home.newsletter.read')} →` : t('home.sign.substack')}
  </p>
</a>
