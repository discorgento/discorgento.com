---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '~/lib/i18n';

const locale = Astro.currentLocale ?? 'pt-BR';
const t = useTranslations(locale);
const otherLocale = locale === 'pt-BR' ? 'en' : 'pt-BR';
const otherLabel = locale === 'pt-BR' ? 'EN' : 'PT';
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95">
  <div class="h-px bg-gradient-to-r from-transparent via-brand-500/70 to-transparent"></div>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href={getRelativeLocaleUrl(locale, '/')} class="flex items-center gap-2.5">
      <img
        src="/img/logo.svg"
        alt="discorgento logo"
        class="h-8 w-8"
        width={32}
        height={32}
      />
      <span class="text-lg font-bold tracking-tight text-on-background">discorgento</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-6 text-sm md:flex">
      <a href={getRelativeLocaleUrl(locale, '/posts')} class="text-muted transition hover:text-brand-400">
        {t('nav.posts')}
      </a>
      <a href={getRelativeLocaleUrl(locale, '/podcast')} class="text-muted transition hover:text-brand-400">
        {t('nav.podcast')}
      </a>
      <a
        href="https://github.com/discorgento"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted transition hover:text-brand-400"
      >
        GitHub
      </a>
      <a
        href="https://discorgento.com/discord"
        target="_blank"
        rel="noopener noreferrer"
        class="border border-brand-500 px-3 py-1.5 font-semibold text-brand-400 transition hover:bg-brand-500 hover:text-white hover:shadow-[var(--shadow-glow)]"
      >
        {t('nav.discord')}
      </a>
      <a
        href={getRelativeLocaleUrl(otherLocale, Astro.url.pathname.replace(/^\/en/, '') || '/')}
        class="font-mono text-xs text-muted transition hover:text-brand-400"
        aria-label={t('nav.switchLabel')}
      >
        {otherLabel}
      </a>
    </div>

    <!-- Mobile nav (no JS: <details> toggle) -->
    <details class="group relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center border border-border text-muted transition hover:border-brand-500 hover:text-brand-400 [&::-webkit-details-marker]:hidden"
        aria-label={t('nav.menu')}
      >
        <svg
          class="h-5 w-5 group-open:hidden"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M3 5h14M3 10h14M3 15h14" />
        </svg>
        <svg
          class="hidden h-5 w-5 group-open:block"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M5 5l10 10M15 5L5 15" />
        </svg>
      </summary>
      <div class="absolute right-0 top-full z-50 mt-2 w-64 border border-border bg-surface-raised p-4 shadow-[var(--shadow-glow-card)]">
        <div class="flex flex-col text-sm" onclick="this.closest('details').open = false">
          <a
            href={getRelativeLocaleUrl(locale, '/posts')}
            class="border-b border-border py-3 text-on-background transition hover:text-brand-400"
          >
            {t('nav.posts')}
          </a>
          <a
            href={getRelativeLocaleUrl(locale, '/podcast')}
            class="border-b border-border py-3 text-on-background transition hover:text-brand-400"
          >
            {t('nav.podcast')}
          </a>
          <a
            href="https://github.com/discorgento"
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-border py-3 text-on-background transition hover:text-brand-400"
          >
            GitHub
          </a>
          <div class="flex items-center justify-between gap-3 py-3">
            <a
              href="https://discorgento.com/discord"
              target="_blank"
              rel="noopener noreferrer"
              class="border border-brand-500 px-3 py-2 font-semibold text-brand-400 transition hover:bg-brand-500 hover:text-white"
            >
              {t('nav.discord')}
            </a>
            <a
              href={getRelativeLocaleUrl(otherLocale, Astro.url.pathname.replace(/^\/en/, '') || '/')}
              class="font-mono text-xs text-muted transition hover:text-brand-400"
              aria-label={t('nav.switchLabel')}
            >
              {otherLabel}
            </a>
          </div>
        </div>
      </div>
    </details>
  </nav>
</header>