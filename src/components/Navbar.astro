---
import { getRelativeLocaleUrl } from 'astro:i18n';
import MenuTrigger from '~/components/MenuTrigger.astro';
import {
  intlLocale,
  LOCALE_META,
  LOCALES,
  type Locale,
  stripLocale,
  useTranslations,
} from '~/lib/i18n';

interface Props {
  /** The home page renders its own big masthead, so it can drop this small lockup. */
  showLockup?: boolean;
  /**
   * Render the root as <header> (a banner landmark). The home page sets this to
   * false because it already has a banner — the masthead — and two banners fail
   * axe's landmark-no-duplicate-banner.
   */
  banner?: boolean;
}

type Section = {
  n: string;
  label: string;
  href: string;
  external?: boolean;
  brand?: boolean;
};

const locale = Astro.currentLocale ?? 'pt-BR';
const t = useTranslations(locale);
const { showLockup = true, banner = true } = Astro.props;
const NavRoot = banner ? 'header' : 'div';

const substackUrl = 'https://discorgento.substack.com';
const discordUrl = 'https://discorgento.com/discord';
const githubUrl = 'https://github.com/discorgento';

const homeUrl = getRelativeLocaleUrl(locale, '/');
// Locale-prefixed routes (/en/podcast/, /es/podcast/) must match their
// unprefixed siblings so the active-section test works the same in every
// edition. Section hrefs carry the prefix too, so both sides get stripped.
const base = stripLocale(Astro.url.pathname);
const isActive = (href: string) => {
  const clean = stripLocale(href);
  return base === clean || base.startsWith(`${clean}/`);
};

// Numbered index: the sections of the zine, in reading order.
const sections: Section[] = [
  {
    n: '01',
    label: t('nav.podcast'),
    href: getRelativeLocaleUrl(locale, '/podcast'),
  },
  {
    n: '02',
    label: t('nav.team'),
    href: getRelativeLocaleUrl(locale, '/quem-faz'),
  },
  {
    n: '03',
    label: t('nav.discord'),
    href: discordUrl,
    external: true,
    brand: true,
  },
];

const outbound = [
  { label: 'Substack', href: substackUrl },
  { label: 'GitHub', href: githubUrl },
];

// Every other edition, linked to the same page. The accessible name pairs the
// code with the locale's own endonym, so it reads no matter which language the
// visitor understands — and the visible code stays inside the name (WCAG 2.5.3).
const currentCode = LOCALE_META[locale as Locale]?.code ?? 'PT';
const switchLinks = LOCALES.filter((l) => l !== locale).map((l) => ({
  locale: l,
  href: getRelativeLocaleUrl(l, base),
  ...LOCALE_META[l],
}));

// The masthead's secondary line (tagline + build date). On mobile the masthead
// drops it to stay a clean logo, so the panel carries it instead.
const tagline = t('home.hero.eyebrow');
const todayLabel = new Intl.DateTimeFormat(intlLocale(locale), {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date());
---

<NavRoot class="nav-plane bg-background">
  <div class:list={['mx-auto flex w-full max-w-[74rem] items-center justify-between gap-6 px-5 py-3 sm:px-6', !showLockup && 'max-md:hidden']}>
    <!-- Lockup + index share one left-aligned cluster -->
    <div class="flex min-w-0 items-center gap-8">
      {showLockup && (
        <a href={homeUrl} class="lockup flex shrink-0 items-center gap-2">
          <span class="logo" aria-hidden="true">
            <img src="/img/logo.svg" alt="" width={28} height={28} />
            <span class="logo-ghost"></span>
          </span>
          <span class="text-xl font-extrabold lowercase tracking-tight text-on-background [font-family:var(--font-brand)]">
            discorgento
          </span>
        </a>
      )}

    <!-- Desktop: numbered index + outbound + locale control -->
    <nav
      class="hidden items-center gap-5 font-mono text-[0.8rem] tracking-[0.12em] uppercase md:flex"
      aria-label={t('nav.primary')}
    >
      {
        sections.map((s) => (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
            aria-current={!s.external && isActive(s.href) ? 'page' : undefined}
            class:list={[
              'inline-flex items-center gap-1.5 border-b-2 pt-1 pb-0.5 transition hover:text-brand-400',
              !s.external && isActive(s.href) ? 'border-brand-500' : 'border-transparent',
              s.brand ? 'font-bold text-brand-500' : isActive(s.href) ? 'text-on-background' : 'text-muted',
            ]}
          >
            {/* Decorative index number. aria-hidden keeps it out of the a11y
                tree, but contrast is judged on rendered pixels, so the opacity
                floor is 0.9: the span inherits its colour from the link, and
                over brand-500 the lower steps land at 4.09:1 (0.8) and
                3.73:1 (0.75), both under AA. At 0.9 it is 4.91:1 on brand and
                5.23:1 on muted, so one value covers both. */}
            <span class="text-[0.65rem] tabular-nums opacity-90" aria-hidden="true">
              {s.n}
            </span>
            <span>{s.label}</span>
            {/* Inherits the parent's colour at full strength. An opacity
                dim here pushed it to 3.73:1 (on brand-500) and 3.94:1 (on
                muted); the glyph is small enough to still read as secondary. */}
            {s.external && (
              <span class="text-[0.7rem]" aria-hidden="true">
                ↗
              </span>
            )}
          </a>
        ))
      }

      <span class="h-4 w-px bg-border" aria-hidden="true" />

      {
        outbound.map((o) => (
          <a
            href={o.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 border-b-2 border-transparent pt-1 pb-0.5 text-muted transition hover:text-brand-400"
          >
            {o.label}
            <span class="text-[0.7rem]" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }

      <span class="h-4 w-px bg-border" aria-hidden="true" />

      <span class="inline-flex items-center gap-1.5 border border-border px-2 py-1">
        <span class="text-on-background" aria-hidden="true">{currentCode}</span>
        <span class="text-border" aria-hidden="true">/</span>
        {/* The code leads the accessible name (WCAG 2.5.3 Label in Name): the
            visible text is just "EN"/"ES", so the name starts with it before the
            endonym. `lang` tells a screen reader to pronounce it in the target
            language rather than the current one. */}
        {switchLinks.map((l, i) => (
          <>
            {i > 0 && <span class="text-border" aria-hidden="true">·</span>}
            <a
              href={l.href}
              hreflang={l.locale}
              lang={l.locale}
              aria-label={`${l.code}: ${l.name}`}
              class="locale-link text-muted transition hover:text-brand-400"
            >
              {l.code}
            </a>
          </>
        ))}
      </span>
      </nav>
    </div>

    <div class="flex items-center gap-4 md:hidden">
      {/* Popover API trigger. popovertarget wires the toggle, light dismiss
          (tap outside), Escape and focus-return with no JS; the script below
          only adds scroll-lock and closes the sheet when a link is taken. */}
      <MenuTrigger label={t('nav.menu')} />
    </div>
  </div>

  {/* Mobile sheet: top-anchored, full-bleed, auto popover. Lives outside the flex
      row so it can drop into the top layer unpinned to the trigger. */}
  <div id="nav-sheet" popover data-nav-panel class="nav-sheet">
    <div class="nav-sheet__bar">
      <a href={homeUrl} class="lockup flex shrink-0 items-center gap-2">
        <span class="logo" aria-hidden="true">
          <img src="/img/logo.svg" alt="" width={28} height={28} />
          <span class="logo-ghost"></span>
        </span>
        <span class="nav-sheet__word">discorgento</span>
      </a>
      <button
        type="button"
        popovertarget="nav-sheet"
        popovertargetaction="hide"
        class="nav-sheet__close"
        aria-label={t('nav.close')}
      >
        <span class="nav-close" aria-hidden="true">
          <span></span><span></span>
        </span>
      </button>
    </div>

    <nav class="nav-sheet__list" aria-label={t('nav.primary')}>
      {
        sections.map((s, i) => (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
            aria-current={!s.external && isActive(s.href) ? 'page' : undefined}
            style={`--i:${i}`}
            class:list={[
              'nav-sheet__item',
              s.brand ? 'nav-sheet__item--brand' : undefined,
            ]}
          >
            <span class="nav-sheet__n" aria-hidden="true">
              {s.n}
            </span>
            <span class="nav-sheet__label">{s.label}</span>
            <span class="nav-sheet__arrow" aria-hidden="true">
              {s.external ? '↗' : '→'}
            </span>
          </a>
        ))
      }
      {
        outbound.map((o, i) => (
          <a
            href={o.href}
            target="_blank"
            rel="noopener noreferrer"
            style={`--i:${sections.length + i}`}
            class="nav-sheet__item nav-sheet__item--out"
          >
            <span class="nav-sheet__label">{o.label}</span>
            <span class="nav-sheet__arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </nav>

    <p class="nav-sheet__meta">
      <span>{tagline}</span>
      <span class="nav-sheet__dot" aria-hidden="true">●</span>
      <span>{todayLabel}</span>
    </p>

    <div class="nav-sheet__foot">
      <span class="nav-sheet__foot-label">{t('nav.language')}</span>
      <span class="inline-flex items-center gap-1.5 border border-border px-2 py-1">
        <span class="text-on-background" aria-hidden="true">{currentCode}</span>
        <span class="text-border" aria-hidden="true">/</span>
        {
          switchLinks.map((l, i) => (
            <>
              {i > 0 && (
                <span class="text-border" aria-hidden="true">
                  ·
                </span>
              )}
              <a
                href={l.href}
                hreflang={l.locale}
                lang={l.locale}
                aria-label={`${l.code}: ${l.name}`}
                class="locale-link text-muted transition hover:text-brand-400"
              >
                {l.code}
              </a>
            </>
          ))
        }
      </span>
    </div>
  </div>

  <!-- Double rule, same as the zine -->
  <div class:list={['h-0.5 bg-on-background', !showLockup && 'max-md:hidden']}></div>
  <div class:list={['h-px bg-border', !showLockup && 'max-md:hidden']}></div>
</NavRoot>

<style>
  /* The running head had no plane: bg-background is the same tone as the page,
     so the band read as a gap rather than a strip. It now carries the same
     halftone dot field as the team block. The cell is tightened from the team's
     14px to 10px because the band is ~56px tall and the coarser grid all but
     vanished at that height. background-image, not the shorthand, so the
     bg-background utility keeps owning the base colour. */
  .nav-plane {
    background-image: radial-gradient(
      circle,
      rgb(236 103 55 / 0.1) 1px,
      transparent 1.2px
    );
    background-size: 10px 10px;
    background-position: center;
  }
  /* ---- Logo mark: same tear as the masthead, at 28px ----
     The nav mark is the same SVG, so the same mask trick works. The offsets are
     larger than the masthead's because 28px gives the clip band less room to
     read; 0.08em of a 40px lockup is a visible tear but only 2px here. */
  .lockup .logo {
    position: relative;
    display: block;
    height: 1.75rem;
    width: 1.75rem;
    flex-shrink: 0;
  }
  .lockup .logo img {
    display: block;
    height: 100%;
    width: 100%;
  }
  .lockup .logo-ghost {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-color: var(--color-background);
    mask-image: url('/img/logo.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    opacity: 0;
    will-change: transform, clip-path, opacity;
  }
  .lockup:hover .logo-ghost {
    animation: 0.4s steps(3, end) nav-glitch both;
  }
  .lockup:hover .logo img {
    animation: 0.4s steps(3, end) nav-jitter both;
  }
  @keyframes nav-glitch {
    0% {
      opacity: 0;
      transform: none;
      clip-path: inset(24% 0 58% 0);
    }
    33% {
      opacity: 0.9;
      transform: translateX(-0.14em);
      clip-path: inset(38% 0 34% 0);
    }
    66% {
      opacity: 0.7;
      transform: translateX(0.11em);
      clip-path: inset(62% 0 12% 0);
    }
    100% {
      opacity: 0;
      transform: none;
      clip-path: inset(24% 0 58% 0);
    }
  }
  @keyframes nav-jitter {
    0%,
    100% {
      transform: none;
    }
    33% {
      transform: translateX(-1px);
    }
    66% {
      transform: translateX(1px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lockup .logo img,
    .lockup .logo-ghost {
      animation: none;
    }
  }
  /* Locale switcher tap target. The bare code links measure 18x19px on a phone
     and sit shoulder to shoulder, so padding would shove the row apart. An
     overlay grows the hit area without moving the codes. Block-ish rather than
     full-bleed: a full-width overlay per link would make the three codes
     overlap, since they are only a couple of characters apart. */
  @media (max-width: 639px) {
    .locale-link {
      position: relative;
    }
    .locale-link::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      width: 44px;
      height: 44px;
      transform: translate(-50%, -50%);
    }
  }

  /* ---- Mobile sheet (Popover API) ----
     A top-anchored, full-bleed sheet. It drops into the top layer, so no z-index
     is needed and it is never clipped by an ancestor. The UA gives us light
     dismiss, Escape and focus-return; we only own the look and the motion. */
  .nav-sheet {
    position: fixed;
    inset: 0 0 auto;
    width: 100%;
    max-width: none;
    max-height: 88vh;
    margin: 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background-color: var(--color-background);
    color: var(--color-on-background);
    /* Closed state seeds the enter/exit transition (see @starting-style). */
    opacity: 0;
    transform: translateY(-12px);
    transition:
      opacity 0.24s ease,
      transform 0.24s ease,
      overlay 0.24s allow-discrete,
      display 0.24s allow-discrete;
  }
  .nav-sheet:popover-open {
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .nav-sheet:popover-open {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .nav-sheet::backdrop {
    background-color: rgb(20 12 8 / 0.45);
    opacity: 0;
    transition:
      opacity 0.24s ease,
      overlay 0.24s allow-discrete,
      display 0.24s allow-discrete;
  }
  .nav-sheet:popover-open::backdrop {
    opacity: 1;
  }
  @starting-style {
    .nav-sheet:popover-open::backdrop {
      opacity: 0;
    }
  }

  .nav-sheet__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background-image: radial-gradient(
      circle,
      rgb(236 103 55 / 0.1) 1px,
      transparent 1.2px
    );
    background-size: 10px 10px;
    background-position: center;
  }
  .nav-sheet__word {
    font-family: var(--font-brand);
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: lowercase;
    letter-spacing: -0.02em;
  }
  /* The close control is a real 44px target; the glyph is two crossed bars so it
     reads as an X without an icon font. */
  .nav-sheet__close {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    background-color: transparent;
    color: var(--color-on-background);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .nav-sheet__close:hover {
    border-color: var(--color-brand-500);
    color: var(--color-brand-400);
  }
  .nav-close {
    position: relative;
    display: block;
    height: 1rem;
    width: 1rem;
  }
  .nav-close span {
    position: absolute;
    inset: 0;
    margin: auto;
    height: 2px;
    width: 1rem;
    background-color: currentColor;
  }
  .nav-close span:first-child {
    transform: rotate(45deg);
  }
  .nav-close span:last-child {
    transform: rotate(-45deg);
  }

  .nav-sheet__list {
    display: flex;
    flex-direction: column;
  }
  /* Rows are full-width, 56px minimum, and hairline-separated like the zine
     index. The number is decorative; the label carries the weight. */
  .nav-sheet__item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 1.05rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-on-background);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav-sheet__item:hover,
  .nav-sheet__item:focus-visible {
    color: var(--color-brand-400);
  }
  .nav-sheet__item[aria-current='page'] {
    color: var(--color-brand-500);
  }
  .nav-sheet__item--brand {
    font-weight: 700;
    color: var(--color-brand-500);
  }
  .nav-sheet__item--out {
    color: var(--color-muted);
  }
  .nav-sheet__n {
    font-size: 0.72rem;
    opacity: 0.75;
  }
  .nav-sheet__label {
    flex: 1;
  }
  .nav-sheet__arrow {
    font-size: 0.9rem;
  }

  /* Staggered entrance for the rows. The motion is decorative, so it is removed
     entirely under reduced-motion (the rows then simply appear). */
  .nav-sheet:popover-open .nav-sheet__item {
    animation: nav-sheet-item 0.32s ease both;
    animation-delay: calc(var(--i, 0) * 45ms + 70ms);
  }
  @keyframes nav-sheet-item {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-sheet,
    .nav-sheet::backdrop {
      transition: none;
    }
    .nav-sheet:popover-open .nav-sheet__item {
      animation: none;
    }
  }

  .nav-sheet__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }
  .nav-sheet__foot-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* The masthead's secondary line, carried here on mobile. */
  .nav-sheet__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    padding: 0.9rem 1.25rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .nav-sheet__dot {
    position: relative;
    top: -0.105em;
    color: var(--color-muted);
  }
</style>

<script>
  // The Popover API already covers light dismiss, Escape and focus-return. This
  // only adds two things it does not: lock the page scroll while the sheet is
  // open, and close the sheet when a link inside it is followed. Both are
  // progressive — without JS the sheet still opens, dismisses and closes on Esc.
  const sheet = document.getElementById('nav-sheet');

  sheet?.addEventListener('toggle', (event) => {
    const open = (event as ToggleEvent).newState === 'open';
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });

  document.addEventListener('click', (event) => {
    const panel = (event.target as HTMLElement | null)?.closest('[data-nav-panel]');
    if (panel instanceof HTMLElement) panel.hidePopover();
  });
</script>
