---
import EpisodeArt from '~/components/EpisodeArt.astro';
import YouTubeStamp from '~/components/YouTubeStamp.astro';
import { useTranslations } from '~/lib/i18n';
import type { Video } from '~/lib/youtube';
import { episodeNum, formatEpDate, getLatestVideos } from '~/lib/youtube';

interface Props {
  locale: string;
  videos?: Video[];
}

/* The home episodes grid (indexes 1..7 — index 0 is the cover island above),
   rendered two ways by the same component:
 *
 *  - The `server:defer` island render: `Astro.props.videos` is absent, so this
 *    fetches the channel live at request time and slices — new episodes appear
 *    without a redeploy.
 *  - The `slot="fallback"` render (with `videos`): the build-time stand-in, the
 *    committed snapshot slice supplied by Home so the build never talks to
 *    YouTube.
 *
 * `.eps` is wrapped in the `server:defer` island only; the section head above
 * it stays static in Home. Styles live here, not in Home, because an island
 * renders outside the page's component scope — and since the fallback is this
 * same component, one copy styles both renders.
 */
const { locale, videos } = Astro.props;
const t = useTranslations(locale);

const episodes = videos ?? (await getLatestVideos()).slice(1, 7);

/* Cards 4-6 are `display:none` on phones (nth-child rule below), but a hidden
   <img> still downloads, so those cards carry this 1x1 transparent GIF as a
   max-width:767px <picture> source: the browser matches it and skips the ~45 kB
   cover. It is a data: URI, so it costs no request. */
const MOBILE_PLACEHOLDER =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

if (videos === undefined) {
  /* Deliberate no-store, matching LatestEdition: the island is per-view data,
     not a cacheable asset. The YouTube feed request is edge-cached
     (cf.cacheTtl in youtube.ts), so this does not hammer the publication. */
  Astro.response.headers.set('Cache-Control', 'no-store');
}
---

{episodes.length > 0 && (
  /* Scoped styles are compiled against this component's own attribute, so the
     island needs its own `.zine` ancestor to match the `.zine .x` rules below
     (Home's `.zine` carries Home's hash, not ours). The wrapper is a plain
     block inside Home's `.wrap`. */
  <div class="zine">
    <div class="eps">
      {episodes.map((ep, i) => (
        <a href={ep.url} target="_blank" rel="noopener noreferrer" class="ep">
        <div class="art-wrap">
          <EpisodeArt
            id={ep.id}
            alt={ep.title}
            pictureClass="contents"
            imgClass="art"
            sizes="(min-width: 768px) 24rem, 90vw"
            {...(i >= 3
              ? { smallScreenSource: { media: '(max-width: 767px)', src: MOBILE_PLACEHOLDER } }
              : {})}
          />
          <YouTubeStamp uid={`home-${ep.id}`} />
        </div>
        <div class="body">
          <p class="meta">
            <span class="num">{episodeNum(ep.title) ? `#${episodeNum(ep.title)}` : t('home.featuredEp.eyebrow')}</span>
            <span class="date">{formatEpDate(ep.published, locale)}</span>
          </p>
          <h3 class="title">{ep.title}</h3>
          <p class="go">{t('home.toc.watch')}</p>
        </div>
      </a>
      ))}
    </div>
  </div>
)}

<style>
  /* These rules were scoped in Home.astro; they live here now so the island
     output (rendered at request time, outside Home's scope) is styled. The
     build-time fallback is this same component, so one copy styles both. */

  .zine a {
    color: inherit;
    text-decoration: none;
  }

  .zine .eps {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .zine .eps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .zine .eps {
      grid-template-columns: repeat(3, 1fr);
    }
    .zine .ep .art-wrap {
      max-height: 13.5rem;
    }
  }
  .zine .ep {
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 5px 5px 0 var(--color-brand-500);
    transition: background 0.15s, transform 0.2s, box-shadow 0.2s;
  }
  .zine .ep:hover {
    background: var(--color-background);
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--color-brand-500);
  }
  /* Phone: the card stacks like desktop — a full-width cover so the art is
     actually visible, with the body underneath. Single column, and only the
     first three cards; desktop keeps all six in the grid. */
  @media (max-width: 767px) {
    .zine .ep {
      box-shadow: 3px 3px 0 var(--color-brand-500);
    }
    .zine .ep:hover {
      transform: translate(-1px, -1px);
      box-shadow: 5px 5px 0 var(--color-brand-500);
    }
    .zine .eps > *:nth-child(n + 4) {
      display: none;
    }
  }
  .zine .ep::before {
    content: '';
    position: absolute;
    top: 0.55rem;
    left: 0.9rem;
    z-index: 1;
    width: 3.25rem;
    height: 1.05rem;
    background: rgb(236 103 55 / 0.55);
    transform: rotate(-4deg);
    pointer-events: none;
  }
  .zine .ep .art-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
  }
  .zine .ep .art-wrap :global(.yt-pill) {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    z-index: 2;
  }
  /* The <picture> wrapper is display: contents via EpisodeArt's Tailwind
     `contents` class (a scoped rule here cannot match an element rendered by
     another component); the <img> is styled through :global() for the same
     reason. */
  .zine .ep .art-wrap :global(.art) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-bottom: 1px solid var(--color-border);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .zine .ep:hover .art-wrap :global(.art) {
    transform: scale(1.04);
  }
  .zine .ep .body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }
  .zine .ep .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .zine .ep .meta .num {
    color: var(--color-brand-500);
    font-weight: 700;
  }
  .zine .ep .title {
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .zine .ep .go {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-brand-400);
    transition: color 0.2s ease;
  }
  .zine .ep:hover .go {
    color: var(--color-brand-500);
  }
  /* Tear on hover: same clip-path band as the host photos in Home. */
  .zine .ep .art-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-color: var(--color-on-background);
    opacity: 0;
    clip-path: inset(30% 0 44% 0);
    will-change: transform, clip-path, opacity;
  }
  .zine .ep:hover .art-wrap::after {
    animation: 0.42s steps(3, end) dg-tear both;
  }
  @keyframes dg-tear {
    0% {
      opacity: 0;
      transform: none;
      clip-path: inset(30% 0 44% 0);
    }
    33% {
      opacity: 0.85;
      transform: translateX(-0.5rem);
      clip-path: inset(42% 0 30% 0);
    }
    66% {
      opacity: 0.6;
      transform: translateX(0.35rem);
      clip-path: inset(18% 0 56% 0);
    }
    100% {
      opacity: 0;
      transform: none;
      clip-path: inset(30% 0 44% 0);
    }
  }

  /* Grid cascade on reveal — the `.eps` lives inside Home's .reveal band; the
     island's cards are inserted after .in, so the animation fires on insert.
     The ancestors (.js .zine .reveal.in) belong to Home's markup, so they must
     stay inside :global() or the island's own hash would be required on them
     and the gate would never match. */
  :global(.js .zine .reveal.in) .eps > * {
    animation: dg-rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  :global(.js .zine .reveal.in) .eps > *:nth-child(1) {
    animation-delay: 0.06s;
  }
  :global(.js .zine .reveal.in) .eps > *:nth-child(2) {
    animation-delay: 0.13s;
  }
  :global(.js .zine .reveal.in) .eps > *:nth-child(3) {
    animation-delay: 0.2s;
  }
  :global(.js .zine .reveal.in) .eps > *:nth-child(4) {
    animation-delay: 0.27s;
  }
  @keyframes dg-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Mobile: the same slimming pass as the consent card and the privacy page —
     tighter list gap, tighter cards, smaller type. Declared last so it wins
     over the base sizes above. */
  @media (max-width: 767px) {
    .zine .eps {
      gap: 0.75rem;
    }
    .zine .ep .body {
      padding: 0.75rem;
      gap: 0.3rem;
    }
    .zine .ep .meta {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }
    .zine .ep .title {
      font-size: 0.95rem;
    }
    .zine .ep .go {
      font-size: 0.72rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js .zine .reveal.in) .eps > * {
      animation: none;
    }
    .zine .ep .go,
    .zine .ep .art-wrap :global(.art) {
      transition: none;
    }
    .zine .ep:hover .go,
    .zine .ep:hover .art-wrap :global(.art) {
      transform: none;
    }
    .zine .ep {
      animation: none;
      transition: none;
      transform: none;
    }
  }
</style>