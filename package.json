{
  "name": "discorgento",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "scripts": {
    "dev": "astro dev",
    "dev:start": "astro dev --background",
    "dev:reset": "npm run build -- --keep-server && npm run dev:start",
    "dev:stop": "astro dev stop",
    "build": "node scripts/build.mjs",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "wrangler": "^4.131.1"
  }
}
