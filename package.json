{
  "name": "discorgento",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "scripts": {
    "dev": "astro dev",
    "dev:start": "astro dev --background",
    "dev:reset": "npm run build -- --keep-server && npm run dev:start",
    "dev:stop": "astro dev stop",
    "build": "node scripts/build.mjs",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import ./test/setup.mjs --test 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/sitemap": "^3.7.4",
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.0",
    "wrangler": "^4.158.0"
  }
}
