# Dependencies
node_modules/

# Build output
dist/

# Astro generated types
.astro/

# Wrangler (Cloudflare)
# wrangler.jsonc (production) and wrangler.staging.jsonc (staging) ARE versioned — no secrets inside.
# .wrangler/ may contain sensitive state; a local wrangler.toml would conflict
# with the versioned wrangler.jsonc — if one exists, delete it.
.wrangler/
wrangler.toml

# Environment
# The Vite/Astro convention, not just .env and .env.production: .env.local,
# .env.staging and .env.development are the ones that actually show up. This
# project has a staging Worker, so a staged .env.staging is a real risk.
.env
.env.*
!.env.example

# Misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*